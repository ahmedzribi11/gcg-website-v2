---
import Icon from './Icon.astro'
import { qrPath, route, useT, type Lang } from '../i18n'
import { contact, whatsappLink } from '../lib/settings'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)
const wa = whatsappLink(t('contact.form.intro'))
---

<section class="relative flex min-h-svh items-center overflow-hidden bg-ink py-32" aria-labelledby="final-title">
  <div class="absolute inset-0" aria-hidden="true">
    <div class="css-fog"><span></span><span></span><span></span></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_55%,rgba(5,46,20,0.6),transparent_65%)]"></div>
  </div>
  <div class="wrap relative flex flex-col items-center text-center">
    <p class="label text-gold" data-reveal>{t('final.kicker')}</p>
    <h2 id="final-title" class="display mt-8 text-[clamp(4rem,16vw,15rem)]" data-split>
      <em class="serif">{t('final.title')}</em>
    </h2>
    <p class="mt-8 max-w-lg text-[15px] leading-relaxed text-bone/65 md:text-base" data-reveal>{t('final.lead')}</p>
    <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row" data-reveal>
      {
        wa && (
          <a href={wa} target="_blank" rel="noopener" class="btn btn-gold !min-h-16 !px-9" data-magnetic>
            <Icon name="whatsapp" size={18} /> {t('cta.whatsapp')}
          </a>
        )
      }
      <a href={route('contact', lang)} class:list={['btn !min-h-16 !px-9', wa ? 'btn-line' : 'btn-gold']} data-magnetic>
        {t('cta.project')} <Icon name="arrow" />
      </a>
      {
        contact.phoneHref && (
          <a href={contact.phoneHref} class="btn btn-line !min-h-16 !px-9">
            <Icon name="phone" /> {contact.phone}
          </a>
        )
      }
    </div>

    <a href={route('share', lang)} class="group mt-20 flex items-center gap-5 rounded-2xl border border-line bg-ink/40 p-3 pr-6 text-left backdrop-blur transition-colors hover:border-gold/60" data-reveal>
      <span class="block w-16 rounded-lg bg-white p-1" data-qr={qrPath(lang)} aria-hidden="true"></span>
      <span>
        <span class="meta block text-gold">{t('contact.share')}</span>
        <span class="mt-1 block text-[13px] text-bone/60" data-qr-text="/"></span>
      </span>
    </a>
  </div>
</section>

<script>
  import '../scripts/qr'
</script>

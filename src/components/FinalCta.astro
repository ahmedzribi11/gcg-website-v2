---
import Icon from './Icon.astro'
import { qrPath, route, useT, type Lang } from '../i18n'
import { contact, pageWhatsApp } from '../lib/settings'

interface Props {
  lang: Lang
  /** Titre de la page, nommé dans le message WhatsApp (CODE-06) ; défaut : Accueil. */
  page?: string
}
const { lang, page } = Astro.props
const t = useT(lang)
const wa = pageWhatsApp(lang, page)
---

<section class="relative flex min-h-svh items-center overflow-hidden bg-ink py-32" aria-labelledby="final-title">
  <div class="wrap relative flex flex-col items-center text-center">
    <!-- Section « action » : titre puis boutons, WhatsApp et téléphone d’abord (SLOP-16, AUDIT-2 3.5) ; mots gardés, en romain (SLOP-02) -->
    <h2 id="final-title" class="display text-3xl">{t('final.title')}</h2>
    <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row sm:flex-wrap sm:justify-center">
      {
        wa && (
          <a href={wa} target="_blank" rel="noopener" class="btn btn-gold !min-h-16 max-w-full whitespace-normal text-center !px-9">
            <Icon name="whatsapp" size={20} /> {t('cta.whatsapp')}
          </a>
        )
      }
      {
        contact.phoneHref && (
          <a href={contact.phoneHref} class="btn btn-line !min-h-16 max-w-full whitespace-normal text-center !px-9">
            <Icon name="phone" size={20} /> {contact.phone}
          </a>
        )
      }
      <a href={route('contact', lang)} class:list={['btn !min-h-16 max-w-full whitespace-normal text-center !px-9', wa ? 'btn-line' : 'btn-gold']}>
        {t('cta.project')} <Icon name="arrow" size={20} />
      </a>
    </div>

    <a href={route('share', lang)} class="group mt-20 flex items-center gap-5 rounded-2xl border border-line bg-ink p-3 pr-6 text-left transition-colors hover:border-gold/60" data-reveal>
      <span class="block w-16 rounded-lg bg-white p-1" data-qr={qrPath(lang)} aria-hidden="true"></span>
      <span>
        <span class="meta block text-gold">{t('contact.share')}</span>
        <span class="mt-1 block text-sm text-bone/60" data-qr-text="/"></span>
      </span>
    </a>
  </div>
</section>

<script>
  import '../scripts/qr'
</script>

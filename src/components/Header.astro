---
import Icon from './Icon.astro'
import { route, useT, type Lang } from '../i18n'
import { contact, whatsappLink } from '../lib/settings'

interface Props {
  lang: Lang
  alt: string
  variant: 'overlay' | 'solid'
}
const { lang, alt, variant } = Astro.props
const t = useT(lang)
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const nav = [
  { href: route('services', lang), label: t('nav.services') },
  { href: route('projects', lang), label: t('nav.projects') },
  { href: route('about', lang), label: t('nav.about') },
  { href: route('invest', lang), label: t('nav.invest') },
  { href: route('contact', lang), label: t('nav.contact') },
]
const isActive = (href: string) => path === href || path.startsWith(href + '/')
const wa = whatsappLink(t('contact.form.intro'))
---

<header
  id="site-header"
  data-variant={variant}
  class="no-print group fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter,transform] duration-700 data-[scrolled]:border-line data-[scrolled]:bg-ink/70 data-[scrolled]:backdrop-blur-xl data-[variant=solid]:border-line data-[variant=solid]:bg-ink/80 data-[variant=solid]:backdrop-blur-xl data-[hidden]:-translate-y-full"
>
  <nav aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'} class="wrap flex h-16 items-center justify-between gap-6 md:h-20">
    <a href={route('home', lang)} class="relative z-10 shrink-0" aria-label="GCG — General Constructor Group CI">
      <img src="/brand/gcg-logo-white.png" alt="GCG — General Constructor Group CI" width="720" height="220" class="h-7 w-auto md:h-8" />
    </a>

    <ul class="hidden items-center gap-8 lg:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['link-line pb-1 text-[13px] tracking-[0.05em] transition-colors duration-500 hover:text-bone', isActive(item.href) ? 'text-gold' : 'text-bone/70']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="relative z-10 flex items-center gap-2 md:gap-3">
      <a href={alt} hreflang={lang === 'fr' ? 'en' : 'fr'} lang={lang === 'fr' ? 'en' : 'fr'} class="meta flex h-10 min-w-10 items-center justify-center rounded-full border border-line px-3 text-bone/80 transition-colors hover:border-bone/50 hover:text-bone" data-lang-switch>
        {t('nav.langShort')}<span class="sr-only"> {t('nav.lang')}</span>
      </a>
      <button
        type="button"
        id="theme-toggle"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-line text-bone/80 transition-colors hover:border-bone/50 hover:text-bone"
        aria-pressed="false"
        aria-label={lang === 'fr' ? 'Mode clair' : 'Light mode'}
        title={lang === 'fr' ? 'Mode clair / sombre' : 'Light / dark mode'}
      >
        <svg data-icon-sun width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
        </svg>
        <svg data-icon-moon width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
        </svg>
      </button>
      <a href={wa || route('contact', lang)} target={wa ? '_blank' : undefined} rel={wa ? 'noopener' : undefined} class="btn btn-gold hidden !min-h-10 !px-5 !text-[12px] md:inline-flex" data-magnetic>
        {wa && <Icon name="whatsapp" size={15} />}
        {t('nav.cta')}
      </a>
      <button type="button" id="menu-toggle" class="meta flex h-10 items-center gap-3 rounded-full border border-line px-4 text-bone lg:hidden" aria-expanded="false" aria-controls="mobile-menu">
        <span data-label-open>{t('nav.menu')}</span><span data-label-close hidden>{t('nav.close')}</span>
        <span class="relative block h-2.5 w-4" aria-hidden="true">
          <span class="menu-bar absolute left-0 top-0 h-px w-full bg-bone transition-transform duration-500"></span>
          <span class="menu-bar absolute left-0 top-2 h-px w-full bg-bone transition-transform duration-500"></span>
        </span>
      </button>
    </div>
  </nav>

</header>

<!--
Hors de l’en-tête : son flou d’arrière-plan (backdrop-filter) et sa translation feraient de l’en-tête le
bloc conteneur du menu fixe, limité à 64 px de haut pendant ~0,7 s (page visible à travers).
-->
<div id="mobile-menu" class="invisible fixed inset-0 z-[49] bg-ink opacity-0 transition-[opacity,visibility] duration-300 lg:hidden" aria-hidden="true">
  <div class="wrap flex h-full flex-col justify-between pb-8 pt-24">
    <ul class="flex flex-col">
      {
        nav.map((item, i) => (
          <li class="overflow-hidden border-b border-line">
            <a href={item.href} tabindex="-1" class="menu-link flex items-baseline justify-between py-4" style={`--i:${i}`}>
              <span class:list={['display text-[2.6rem]', isActive(item.href) && 'text-gold']}>{item.label}</span>
              <span class="meta text-mist">0{i + 1}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex flex-col gap-3">
      {
        wa && (
          <a href={wa} target="_blank" rel="noopener" tabindex="-1" class="btn btn-gold w-full">
            <Icon name="whatsapp" size={18} /> {t('cta.whatsapp')}
          </a>
        )
      }
      {
        contact.phoneHref && (
          <a href={contact.phoneHref} tabindex="-1" class="btn btn-line w-full">
            <Icon name="phone" size={16} /> {contact.phone}
          </a>
        )
      }
      {
        !wa && (
          <a href={route('contact', lang)} tabindex="-1" class="btn btn-gold w-full">
            {t('cta.project')}
          </a>
        )
      }
    </div>
  </div>
</div>

<style>
  #site-header[data-menu] + #mobile-menu { visibility: visible; opacity: 1; }
  #site-header[data-menu] { background: transparent !important; border-color: transparent !important; backdrop-filter: none !important; }
  #site-header[data-menu] .menu-bar:first-child { transform: translateY(4px) rotate(45deg); }
  #site-header[data-menu] .menu-bar:last-child { transform: translateY(-4px) rotate(-45deg); }
  .menu-link { transform: translateY(100%); transition: transform 0.9s var(--ease-out-expo); }
  #site-header[data-menu] + #mobile-menu .menu-link { transform: none; transition-delay: calc(0.08s + var(--i) * 0.06s); }
</style>

---
import SectionHead from './SectionHead.astro'
import { useT, type Lang } from '../i18n'

interface Props {
  lang: Lang
  tone?: 'dark' | 'paper'
}
const { lang, tone = 'dark' } = Astro.props
const t = useT(lang)
const steps =
  lang === 'fr'
    ? [
        ['Étude', 'Faisabilité, programme, premières études.'],
        ['Conception', 'Études architecturales et parti du projet.'],
        ['Ingénierie', 'Structure, fluides, électricité, BIM.'],
        ['Construction', 'Gros œuvre, second œuvre, finitions.'],
        ['Aménagement', 'Intérieurs, extérieurs, piscines.'],
        ['Remise des clés', 'Contrôle qualité et réception.'],
      ]
    : [
        ['Study', 'Feasibility, brief, preliminary studies.'],
        ['Design', 'Architectural design and concept.'],
        ['Engineering', 'Structure, plumbing, electrical, BIM.'],
        ['Construction', 'Structural works, finishing.'],
        ['Fit-out', 'Interiors, exteriors, pools.'],
        ['Handover', 'Quality control and final inspection.'],
      ]
const paper = tone === 'paper'
---

<section class:list={['relative overflow-hidden py-24 md:py-40', paper ? 'theme-paper' : 'bg-ink']} aria-labelledby="method-title">
  <div class="wrap">
    <SectionHead id="method-title" title={t('method.title')} size="md" tone={paper ? 'paper' : 'dark'} />

    <div class="method relative mt-16 md:mt-28">
      <span class:list={['method-rail absolute bottom-2 left-[5px] top-2 w-px lg:bottom-auto lg:left-0 lg:right-0 lg:top-[5px] lg:h-px lg:w-auto', paper ? 'bg-brand/40' : 'bg-gold/50']} aria-hidden="true"></span>
      <ol class="grid gap-10 pl-8 lg:grid-cols-6 lg:gap-6 lg:pl-0 lg:pt-12">
      {
        steps.map(([title, text], i) => (
          <li class="method-step relative" style={`--i:${i}`}>
            <span class:list={['absolute -left-8 top-1.5 block h-[11px] w-[11px] rounded-full lg:-top-[3.05rem] lg:left-0', paper ? 'bg-brand' : 'bg-gold']} aria-hidden="true" />
            <p class:list={['meta', paper ? 'text-brand/75' : 'text-mist']}>{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-3 text-2xl font-light tracking-[-0.03em] lg:text-[clamp(1.3rem,1.8vw,2rem)]">{title}</h3>
            <p class:list={['mt-2 max-w-[24ch] text-[0.875rem] leading-relaxed', paper ? 'text-brand/65' : 'text-bone/55']}>{text}</p>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>

---
interface Props {
  label: string
  title: string
  accent?: string
  lead?: string
  tone?: 'dark' | 'paper' | 'brand'
}
const { label, title, accent, lead, tone = 'dark' } = Astro.props
const html = accent ? title.replace(accent, `<em class="serif">${accent}</em>`) : title
const theme = tone === 'paper' ? 'theme-paper' : tone === 'brand' ? 'theme-brand' : 'bg-ink'
---

<!-- Premier écran : entrée en CSS (data-intro), jamais masquée en attendant le script principal (PERF-03) -->
<header class:list={['relative overflow-hidden pb-14 pt-32 md:pb-20 md:pt-48', theme]}>
  <div class="blueprint pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="wrap relative grid gap-10 md:grid-cols-12 md:items-end">
    <div class="md:col-span-8">
      <p class:list={['label', tone === 'paper' ? 'text-brand/75' : 'text-gold']} data-intro style="--d:.05s">{label}</p>
      <h1 class="display mt-8 text-[clamp(min(2.8rem,14vw),8vw,8.4rem)]" data-intro="rise" style="--d:.1s" set:html={html} />
    </div>
    {
      lead && (
        <p class:list={['max-w-md text-[0.9375rem] leading-relaxed md:col-span-4 md:pb-4 md:text-base', tone === 'paper' ? 'text-brand/70' : 'text-bone/65']} data-intro="rise" style="--d:.2s">
          {lead}
        </p>
      )
    }
    <slot />
  </div>
</header>

<style>
  .blueprint {
    background-image: linear-gradient(currentColor 1px, transparent 1px), linear-gradient(90deg, currentColor 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.035;
    mask-image: radial-gradient(ellipse at 30% 40%, black, transparent 70%);
  }
</style>

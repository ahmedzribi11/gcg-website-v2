---
import { geoMercator, geoPath } from 'd3-geo'
import { feature } from 'topojson-client'
import type { Feature, FeatureCollection, Geometry } from 'geojson'
import type { Topology, GeometryCollection } from 'topojson-specification'
import world from 'world-atlas/countries-50m.json'
import world110 from 'world-atlas/countries-110m.json'
import { cities, type CityId } from '../data/geo'
import { colon, route, useT, type Lang } from '../i18n'
import type { Project } from '../lib/projects'

interface Props {
  lang: Lang
  projects: Project[]
  tone?: 'dark' | 'paper'
  inset?: boolean
  /** Lien des épingles vers la liste filtrée (sinon filtre en place). */
  link?: boolean
}
const { lang, projects, tone = 'dark', inset = true, link = true } = Astro.props
const t = useT(lang)

const countries = (w: unknown) => {
  const topo = w as Topology<{ countries: GeometryCollection }>
  return (feature(topo, topo.objects.countries) as FeatureCollection<Geometry>).features
}
const all = countries(world)
const byId = (id: string) => all.find((f) => String(f.id) === id)!
const ci = byId('384')
const WEST_AFRICA = ['384', '430', '324', '466', '854', '288', '694', '624', '686', '270', '478', '768', '204', '562', '566']
const neighbours = ['430', '324', '466', '854', '288'].map(byId)

// Comptage des projets par localité (seules les localités avec projets sont affichées)
const counts = projects.reduce<Record<string, number>>((a, p) => ((a[p.city] = (a[p.city] ?? 0) + 1), a), {})
const present = Object.keys(counts) as CityId[]
const solo = present.filter((c) => cities[c].zone === 'solo')
const cluster = present.filter((c) => cities[c].zone === 'cluster').sort((a, b) => cities[a].lon - cities[b].lon)

// Étiquettes du littoral : réparties sous la carte, sur deux rangs au-delà de cinq localités
const twoRows = cluster.length > 5
const step = cluster.length > 1 ? Math.min(135, (twoRows ? 600 : 540) / (cluster.length - 1)) : 0
const x0 = 420 - (step * (cluster.length - 1)) / 2
const labelAt = (i: number) => ({ lx: x0 + i * step, ly: twoRows && i % 2 ? 816 : 760 })

const W = 800
const H = twoRows ? 900 : 860
const proj = geoMercator().fitExtent([[60, 40], [W - 60, 640]], ci)
/*
 * Tracés au dixième d’unité (viewBox de 800) au lieu du millième : différence invisible, HTML plus léger sur les
 * trois pages qui intègrent la carte (PERF-06). L’encart, affiché à 150 px de large, utilise le 1:110 m.
 */
const path = geoPath(proj).digits(1)
const pt = (lon: number, lat: number) => proj([lon, lat]) as [number, number]


// Encart Afrique de l’Ouest
const all110 = countries(world110)
const waFeatures = WEST_AFRICA.map((id) => all110.find((f) => String(f.id) === id)!)
const waColl: FeatureCollection<Geometry> = { type: 'FeatureCollection', features: waFeatures }
const IW = 260
const IH = 170
const insetProj = geoMercator().fitExtent([[6, 6], [IW - 6, IH - 6]], waColl)
const insetPath = geoPath(insetProj).digits(1)

const stroke = tone === 'paper' ? 'rgba(5,46,20,.55)' : 'color-mix(in srgb, var(--color-gold) 55%, transparent)'
const fillCi = tone === 'paper' ? 'rgba(5,46,20,.08)' : 'rgba(5,46,20,.55)'
// Version sombre : couleurs du thème (variables), lisibles en mode clair comme en mode sombre
const fillN = tone === 'paper' ? 'rgba(5,46,20,.03)' : 'color-mix(in srgb, var(--color-bone) 3%, transparent)'
const strokeN = tone === 'paper' ? 'rgba(5,46,20,.15)' : 'color-mix(in srgb, var(--color-bone) 14%, transparent)'
const ink = tone === 'paper' ? '#052e14' : 'var(--color-bone)'
const gold = tone === 'paper' ? '#8a7a2e' : 'var(--color-gold)'
const href = (c: string) => `${route('projects', lang)}?ville=${c}`
const pathStr = (f: Feature<Geometry>) => path(f) ?? ''
---

<figure class="presence-map relative" data-tone={tone} data-reveal>
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMin slice" class="map-main h-auto w-full" role="group" aria-labelledby="map-title map-desc">
    <title id="map-title">{t('presence.title')}</title>
    <desc id="map-desc">{(Object.keys(counts) as CityId[]).map((c) => `${cities[c].name}${colon(lang)}${counts[c]} ${t(counts[c] > 1 ? 'projects.count.many' : 'projects.count.one')}`).join(', ')}</desc>
    <defs>
      <clipPath id="map-clip"><rect x="0" y="0" width={W} height={H} /></clipPath>
      <pattern id="map-grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path style={`stroke:${strokeN}`} d="M40 0H0V40" fill="none" stroke-width="0.5" />
      </pattern>
    </defs>
    <rect width={W} height={H} fill="url(#map-grid)" opacity="0.6" />
    <g clip-path="url(#map-clip)">
      {neighbours.map((f) => <path style={`fill:${fillN};stroke:${strokeN}`} d={pathStr(f)} stroke-width="1" />)}
      <path style={`stroke:${stroke}`} d={pathStr(ci)} fill={fillCi} stroke-width="1.4" class="map-ci" />
    </g>

    {/* Villes de l’intérieur : étiquette directe */}
    {
      solo.map((c) => {
        const [x, y] = pt(cities[c].lon, cities[c].lat)
        const n = counts[c] ?? 0
        const left = cities[c].side === 'left'
        const tx = left ? x - 18 : x + 18
        const anchor = left ? 'end' : 'start'
        return (
          <a href={link ? href(c) : undefined} data-city-pin={c} class="map-pin">
            <circle style={`fill:${gold}`} cx={x} cy={y} r={10 + n * 2.5} opacity="0.16" class="map-halo" />
            <circle style={`fill:${gold}`} cx={x} cy={y} r="5" />
            <text style={`fill:${ink}`} x={tx} y={y - 4} font-size="22" text-anchor={anchor}>{cities[c].name}</text>
            <text style={`fill:${gold}`} x={tx} y={y + 20} font-size="13" text-anchor={anchor} font-weight="600">{n} {n > 1 ? t('projects.count.many').toUpperCase() : t('projects.count.one').toUpperCase()}</text>
          </a>
        )
      })
    }

    {/* Littoral : annotations avec lignes de rappel */}
    {
      cluster.map((c, i) => {
        const [x, y] = pt(cities[c].lon, cities[c].lat)
        const n = counts[c] ?? 0
        const { lx, ly } = labelAt(i)
        return (
          <a href={link ? href(c) : undefined} data-city-pin={c} class="map-pin">
            <polyline class="map-leader" style={`stroke:${stroke}`} points={`${x},${y} ${x},${y + 26} ${lx},${ly - 58} ${lx},${ly - 40}`} fill="none" stroke-width="0.8" stroke-dasharray="2 4" />
            <circle style={`fill:${gold}`} cx={x} cy={y} r={7 + n * 1.6} opacity="0.16" class="map-halo" />
            <circle style={`fill:${gold}`} cx={x} cy={y} r="4" />
            <text style={`fill:${ink}`} x={lx} y={ly} font-size="20" text-anchor="middle">{cities[c].name}</text>
            <text style={`fill:${gold}`} x={lx} y={ly + 26} font-size="13" text-anchor="middle" font-weight="600">{n}</text>
          </a>
        )
      })
    }
    <text style={`fill:${ink}`} x={W - 60} y={H - 22} opacity="0.35" font-size="11" text-anchor="end" font-weight="600">CÔTE D’IVOIRE · OCÉAN ATLANTIQUE</text>
  </svg>

  {
    inset && (
      <figcaption class="ml-auto mt-2 flex w-full items-end justify-end gap-4"><span class="w-36 md:w-44">
        <svg viewBox={`0 0 ${IW} ${IH}`} class="h-auto w-full" aria-hidden="true">
          {waFeatures.map((f) => (
            <path style={`fill:${String(f.id) === '384' ? gold : fillN};stroke:${strokeN}`} d={insetPath(f) ?? ''} fill-opacity={String(f.id) === '384' ? 0.85 : 1} stroke-width="0.6" />
          ))}
        </svg>
        </span>
        <p class:list={['meta pb-2 text-right', tone === 'paper' ? 'text-brand' : 'text-mist']}>{lang === 'fr' ? 'Afrique de l’Ouest' : 'West Africa'}</p>
      </figcaption>
    )
  }
</figure>

<style>
  .map-pin { cursor: pointer; }
  .map-pin text { transition: fill 0.4s; }
  .map-halo { transform-box: fill-box; transform-origin: center; animation: halo 3.2s var(--ease-cinema) infinite; }
  .map-pin:hover .map-halo, .map-pin[data-active] .map-halo { opacity: 0.4; }
  @keyframes halo { 0%, 100% { transform: scale(0.85); } 50% { transform: scale(1.15); } }
  /* Téléphone : à l’échelle 0,42 les étiquettes feraient 5 à 9 px. Points seuls, carte recadrée sous la côte
     (la liste des localités porte l’information). Étiquettes transparentes et non retirées : elles restent
     le nom accessible des épingles (un aria-label différerait du texte visible sur ordinateur). */
  @media (max-width: 767px) {
    .map-main text { opacity: 0; }
    .map-main .map-leader { display: none; }
    .map-main { aspect-ratio: 800 / 660; }
  }
</style>

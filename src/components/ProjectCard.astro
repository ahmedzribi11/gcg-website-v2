---
import ProjectImage from './ProjectImage.astro'
import { projectPath, SECTOR_LABELS, STATUS_SHORT, type Lang } from '../i18n'
import { pad, type Project } from '../lib/projects'

interface Props {
  project: Project
  lang: Lang
  size?: 'md' | 'lg'
  theme?: 'dark' | 'paper'
  sizes?: string
  index?: number
  /** Morphing vers la page projet (un seul par projet et par page). */
  transition?: boolean
  /** Masque le secteur (cartes étroites). */
  compact?: boolean
}
const { project: p, lang, size = 'md', theme = 'dark', sizes = '(min-width: 1280px) 30vw, (min-width: 768px) 45vw, 100vw', index = 0, transition = true, compact = false } = Astro.props
const href = projectPath(p.slug, lang)
---

<a
  href={href}
  class="group block"
  data-cursor="view"
  data-project
  data-sector={p.sector}
  data-status={p.status ?? ''}
  data-city={p.city}
  data-types={p.types.join(' ')}
  data-reveal
  style={`--d:${(index % 3) * 0.08}s`}
>
  <div class:list={['relative overflow-hidden', size === 'lg' ? 'aspect-[4/5] md:aspect-[5/4]' : 'aspect-[4/3]', theme === 'paper' ? 'bg-paper-2' : 'bg-ink-3']}>
    <ProjectImage
      image={p.images[0]}
      sizes={sizes}
      imgClass="h-full w-full object-cover transition-transform duration-[1.6s] ease-[var(--ease-out-expo)] group-hover:scale-[1.05]"
      class="block h-full w-full"
      vt={transition ? `p-${p.slug}` : undefined}
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/55 via-transparent to-transparent opacity-80 transition-opacity duration-700 group-hover:opacity-50"></div>
    <span class="meta absolute left-3 top-3 rounded-full bg-ink/60 px-2.5 py-1.5 text-bone backdrop-blur-md">N° {pad(p.number)}</span>
    {p.status && <span class="pill absolute right-3 top-3" data-status={p.status}>{STATUS_SHORT[p.status][lang]}</span>}
  </div>
  <div class="mt-4 flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h3 class:list={['text-balance text-xl font-light tracking-[-0.02em] transition-colors duration-500 md:text-2xl', theme === 'paper' ? 'group-hover:text-brand-2' : 'group-hover:text-gold']}>{p.name}</h3>
      <p class:list={['mt-1 text-[13px]', theme === 'paper' ? 'text-brand/75' : 'text-bone/55']}>{p.location} · {p.period}</p>
    </div>
    <p class:list={['meta mt-1.5 hidden shrink-0 text-right', !compact && 'sm:block', theme === 'paper' ? 'text-brand/45' : 'text-mist']}>{SECTOR_LABELS[p.sector][lang]}</p>
  </div>
</a>

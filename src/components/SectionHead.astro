---
interface Props {
  label: string
  title: string
  /** Mot(s) du titre à mettre en italique serif. */
  accent?: string
  lead?: string
  as?: 'h1' | 'h2'
  size?: 'xl' | 'lg' | 'md'
  align?: 'split' | 'stack'
  tone?: 'dark' | 'paper' | 'brand'
  id?: string
}
const { label, title, accent, lead, as: Tag = 'h2', size = 'lg', align = 'split', tone = 'dark', id } = Astro.props
const sizeClass = {
  xl: 'text-[clamp(2.8rem,8.5vw,9rem)]',
  lg: 'text-[clamp(2.4rem,6vw,6.4rem)]',
  md: 'text-[clamp(2rem,4.2vw,4.2rem)]',
}[size]
const html = accent ? title.replace(accent, `<em class="serif">${accent}</em>`) : title
const leadColor = tone === 'paper' ? 'text-brand/70' : 'text-bone/65'
const labelColor = tone === 'paper' ? 'text-brand/75' : tone === 'brand' ? 'text-gold' : 'text-gold'
---

<div class:list={['grid gap-8', align === 'split' && lead ? 'md:grid-cols-12 md:items-end' : '']}>
  <div class:list={[align === 'split' && lead ? 'md:col-span-8' : '']}>
    <p class:list={['label', labelColor]} data-reveal>{label}</p>
    <Tag id={id} class:list={['display mt-7 max-w-[18ch]', sizeClass]} data-split set:html={html} />
  </div>
  {
    lead && (
      <p class:list={['max-w-md text-[15px] leading-relaxed md:text-base', leadColor, align === 'split' ? 'md:col-span-4 md:pb-3' : '']} data-reveal style="--d:.15s">
        {lead}
      </p>
    )
  }
</div>

---
interface Props {
  title: string
  lead?: string
  as?: 'h1' | 'h2'
  size?: 'xl' | 'lg' | 'md'
  align?: 'split' | 'stack'
  tone?: 'dark' | 'paper' | 'brand'
  id?: string
}
const { title, lead, as: Tag = 'h2', size = 'lg', align = 'split', tone = 'dark', id } = Astro.props
// Minimum plafonné en vw : avec un texte agrandi (taille de police du navigateur), le titre ne dépasse pas l’écran (BRW-10)
const sizeClass = {
  xl: 'text-4xl',
  lg: 'text-3xl',
  md: 'text-2xl',
}[size]
const leadColor = tone === 'paper' ? 'text-brand/70' : 'text-bone/65'
---

<div class:list={['grid gap-8', align === 'split' && lead ? 'md:grid-cols-12 md:items-end' : '']}>
  <div class:list={[align === 'split' && lead ? 'md:col-span-8' : '']}>
    <!-- Titre en texte simple, une seule police, sans mot en italique (SLOP-02), sans surtitre (SLOP-03) -->
    <Tag id={id} class:list={['display max-w-[18ch]', sizeClass]}>{title}</Tag>
  </div>
  {
    lead && (
      <p class:list={['max-w-md text-base leading-relaxed md:text-base', leadColor, align === 'split' ? 'md:col-span-4 md:pb-3' : '']}>
        {lead}
      </p>
    )
  }
</div>

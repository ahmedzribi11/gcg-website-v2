---
/**
 * Titre de section, choisi selon le contenu qui suit (SLOP-16) :
 * - « list » : titre simple, phrase d’introduction en dessous, puis des rangées (expertises, types, étapes, chiffres) ;
 * - « proof » : titre court, puis directement les photos légendées des projets, sans phrase d’introduction ;
 * - « action » : titre puis boutons, sans phrase d’introduction (appel final, FinalCta.astro, et « Un projet similaire ? »
 *   de la fiche projet, qui gardent leur propre mise en page).
 */
interface Props {
  title: string
  lead?: string
  kind?: 'list' | 'proof'
  as?: 'h1' | 'h2'
  size?: 'xl' | 'lg' | 'md'
  tone?: 'dark' | 'paper' | 'brand'
  id?: string
}
const { title, lead, kind = 'list', as: Tag = 'h2', size = kind === 'proof' ? 'md' : 'lg', tone = 'dark', id } = Astro.props
// Tailles de l’échelle de global.css (SLOP-05), plancher en vw intégré pour le texte agrandi (BRW-10)
const sizeClass = {
  xl: 'text-4xl',
  lg: 'text-3xl',
  md: 'text-2xl',
}[size]
const leadColor = tone === 'paper' ? 'text-brand/70' : 'text-bone/65'
---

<div>
  <!-- Titre en texte simple, une seule police, sans mot en italique (SLOP-02), sans surtitre (SLOP-03) -->
  <Tag id={id} class:list={['display max-w-[18ch]', sizeClass]}>{title}</Tag>
  {kind === 'list' && lead && <p class:list={['mt-6 max-w-xl text-base leading-relaxed', leadColor]}>{lead}</p>}
</div>

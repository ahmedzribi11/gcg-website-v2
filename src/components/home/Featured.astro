---
import ProjectCard from '../ProjectCard.astro'
import SectionHead from '../SectionHead.astro'
import Icon from '../Icon.astro'
import { route, useT, type Lang } from '../../i18n'
import type { Project } from '../../lib/projects'

interface Props {
  lang: Lang
  featured: Project[]
}
const { lang, featured } = Astro.props
const t = useT(lang)
---

<!--
Grille de photos légendées (SLOP-14) : tous les projets à la une sont visibles d’emblée, sur toutes les tailles
d’écran, sans défilement horizontal épinglé ni script.
-->
<section id="featured" class="relative bg-ink" aria-labelledby="featured-title">
  <div class="wrap pb-24 pt-24 md:pt-40">
    <SectionHead id="featured-title" kind="proof" title={t('featured.title')} />

    <ul class="mt-8 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 md:mt-10">
      {
        featured.map((p) => (
          <li data-slide>
            <ProjectCard project={p} lang={lang} />
          </li>
        ))
      }
    </ul>

    <div class="pt-14">
      <a href={route('projects', lang)} class="btn btn-line w-full">{t('cta.allProjects')} <Icon name="arrow" size={20} /></a>
    </div>
  </div>
</section>

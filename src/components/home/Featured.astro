---
import ProjectImage from '../ProjectImage.astro'
import ImageKind from '../ImageKind.astro'
import SectionHead from '../SectionHead.astro'
import Icon from '../Icon.astro'
import { projectPath, route, STATUS_SHORT, useT, type Lang } from '../../i18n'
import { pad, type Project } from '../../lib/projects'

interface Props {
  lang: Lang
  featured: Project[]
}
const { lang, featured } = Astro.props
const t = useT(lang)
---

<!--
Défilement horizontal épinglé seulement quand le script l’active (data-pinned, ordinateur, animations permises).
Sans lui (animations réduites, pas de JS, téléphone) : liste verticale, tous les projets restent atteignables.
-->
<section id="featured" class="group/featured relative bg-ink" aria-labelledby="featured-title">
  <div class="wrap pb-14 pt-24 md:pb-6 md:pt-40">
    <SectionHead id="featured-title" label={t('featured.label')} title={t('featured.title')} accent={lang === 'fr' ? 'pour nous.' : 'for us.'} />
  </div>

  <div data-hpin class="relative group-data-[pinned]/featured:h-svh group-data-[pinned]/featured:overflow-hidden">
    <div data-htrack class="mx-auto flex max-w-[1760px] flex-col gap-20 px-5 md:px-10 group-data-[pinned]/featured:h-full group-data-[pinned]/featured:max-w-none group-data-[pinned]/featured:flex-row group-data-[pinned]/featured:items-center group-data-[pinned]/featured:gap-[5vw] group-data-[pinned]/featured:pl-[6vw] group-data-[pinned]/featured:pr-[12vw]">
      {
        featured.map((p, i) => (
          <article data-slide class="relative w-full shrink-0 group-data-[pinned]/featured:h-[72vh] group-data-[pinned]/featured:w-[78vw] lg:group-data-[pinned]/featured:w-[70vw]">
            <a href={projectPath(p.slug, lang)} class="group grid h-full gap-6 md:grid-cols-12 md:gap-10" data-cursor="view">
              <div data-slide-frame class="relative aspect-[4/3] overflow-hidden bg-ink-3 md:col-span-8 group-data-[pinned]/featured:aspect-auto group-data-[pinned]/featured:h-full">
                <div data-slide-media class="absolute -inset-x-[6%] inset-y-0">
                  <ProjectImage image={p.images[0]} sizes="(min-width: 768px) 55vw, 100vw" class="block h-full w-full" imgClass="h-full w-full object-cover transition-transform duration-[1.8s] ease-[var(--ease-out-expo)] group-hover:scale-[1.04]" vt={`p-${p.slug}`} />
                </div>
                {p.status && <span class="pill absolute left-4 top-4" data-status={p.status}>{STATUS_SHORT[p.status][lang]}</span>}
                {!p.status && p.designOnly && <span class="pill absolute left-4 top-4" data-scope="design">{t('project.designOnly')}</span>}
                <ImageKind image={p.images[0]} lang={lang} class="bottom-4 right-4" />
              </div>
              <div data-slide-info class="flex flex-col justify-between md:col-span-4 md:py-2">
                <div>
                  <p class="meta text-gold">N° {pad(p.number)} · {pad(i + 1)}/{pad(featured.length)}</p>
                  <h3 class:list={['display mt-4 text-balance transition-colors duration-500 group-hover:text-gold', p.name.length > 22 ? 'text-[clamp(2rem,3vw,3.4rem)]' : 'text-[clamp(2.2rem,4.2vw,4.6rem)]']}>{p.name}</h3>
                  <p class="mt-5 max-w-sm text-[0.9375rem] leading-relaxed text-bone/65">{p.composition}</p>
                </div>
                <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-line pt-5">
                  <div>
                    <dt class="meta text-mist">{t('project.location')}</dt>
                    <dd class="mt-1 text-[0.9375rem]">{p.location}</dd>
                  </div>
                  <div>
                    <dt class="meta text-mist">{t('project.period')}</dt>
                    <dd class="mt-1 text-[0.9375rem]">{p.period}</dd>
                  </div>
                  {p.surface && (
                    <div>
                      <dt class="meta text-mist">{t('project.surface')}</dt>
                      <dd class="mt-1 text-[0.9375rem]">{p.surface}</dd>
                    </div>
                  )}
                  <div class="flex items-end">
                    <dt class="sr-only">{t('projects.label')}</dt>
                    <dd class="meta inline-flex items-center gap-2 text-bone">
                      {t('cta.discover')} <Icon name="arrow" />
                    </dd>
                  </div>
                </dl>
              </div>
            </a>
          </article>
        ))
      }
    </div>
    <div class="absolute inset-x-10 bottom-8 hidden items-center gap-6 group-data-[pinned]/featured:flex">
      <span class="meta text-mist" aria-hidden="true">{t('featured.label')}</span>
      <div class="h-px flex-1 bg-line" aria-hidden="true"><div data-hprogress class="h-px origin-left scale-x-0 bg-gold"></div></div>
      <a href={route('projects', lang)} class="meta pointer-events-auto text-bone hover:text-gold">{t('cta.allProjects')} →</a>
      <!-- Sortie du défilement horizontal sans faire défiler tous les projets -->
      <button type="button" data-hskip class="meta pointer-events-auto inline-flex h-10 items-center gap-2 rounded-full border border-line px-4 text-bone transition-colors hover:border-gold hover:text-gold">
        {t('featured.skip')} <Icon name="arrow" class="rotate-90" />
      </button>
    </div>
  </div>

  <div class="wrap pb-24 pt-14 group-data-[pinned]/featured:hidden">
    <a href={route('projects', lang)} class="btn btn-line w-full">{t('cta.allProjects')} <Icon name="arrow" /></a>
  </div>
</section>

<script>
  import { gsap, reducedMotion, scrollToEl, touch } from '../../scripts/site'

  const section = document.getElementById('featured')
  const pin = document.querySelector<HTMLElement>('[data-hpin]')
  const track = document.querySelector<HTMLElement>('[data-htrack]')
  const progress = document.querySelector<HTMLElement>('[data-hprogress]')
  // « Passer les projets » : va directement à la section suivante, après tout le défilement horizontal
  const next = document.querySelector('#featured ~ section')
  document.querySelector('[data-hskip]')?.addEventListener('click', () => next && scrollToEl(next))
  if (section && pin && track && !reducedMotion) {
    const mm = gsap.matchMedia()
    mm.add('(min-width: 768px)', () => {
      // Mise en page horizontale (classes group-data-[pinned]) posée avant la création de l’épinglage
      section.setAttribute('data-pinned', '')
      const distance = () => track.scrollWidth - innerWidth
      const tween = gsap.to(track, {
        x: () => -distance(),
        ease: 'none',
        scrollTrigger: {
          trigger: pin,
          start: 'top top',
          end: () => `+=${distance()}`,
          pin: true,
          /*
           * Épinglage par translation (et non position: fixed) quand le défilement est piloté par Lenis :
           * le passage en position fixe comptait comme un décalage de mise en page de 1,0 à l’entrée et à la
           * sortie (GATE-02). Au doigt (défilement natif), position fixe gardée pour éviter les saccades.
           */
          pinType: touch ? 'fixed' : 'transform',
          scrub: 1,
          invalidateOnRefresh: true,
          onUpdate: (self) => progress && (progress.style.transform = `scaleX(${self.progress})`),
        },
      })
      track.querySelectorAll<HTMLElement>('[data-slide]').forEach((slide) => {
        const base = { trigger: slide, containerAnimation: tween, scrub: true }
        gsap.fromTo(slide.querySelector('[data-slide-frame]'), { clipPath: 'inset(10% 18% 10% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', ease: 'none', scrollTrigger: { ...base, start: 'left 95%', end: 'left 40%' } })
        gsap.fromTo(slide.querySelector('[data-slide-media]'), { xPercent: -5 }, { xPercent: 5, ease: 'none', scrollTrigger: { ...base, start: 'left right', end: 'right left' } })
        gsap.fromTo(slide.querySelector('[data-slide-info]'), { opacity: 0, x: 60 }, { opacity: 1, x: 0, ease: 'none', scrollTrigger: { ...base, start: 'left 80%', end: 'left 35%' } })
      })
      return () => section.removeAttribute('data-pinned')
    })
  }
</script>

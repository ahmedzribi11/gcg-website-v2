---
import ProjectImage from '../ProjectImage.astro'
import ImageKind from '../ImageKind.astro'
import Icon from '../Icon.astro'
import { colon, route, useT, type Lang } from '../../i18n'
import { coverImage, publishedOnly, type Project } from '../../lib/projects'

interface Props {
  lang: Lang
  projects: Project[]
}
const { lang, projects } = Astro.props
const t = useT(lang)
const a = coverImage(projects, ['green-city', 0])
const b = coverImage(projects, ['villa-palmeras', 0])
/*
 * Chiffres clés tirés des fiches projet, chacun avec son contexte (SLOP-17, COPY-03) : année de création, projets du
 * portfolio, projets réceptionnés (nommés tant qu’ils sont un ou deux), projets en chantier (dont le plus grand
 * programme). Les comptes suivent le statut saisi dans chaque fiche ; un compte nul n’est pas affiché.
 */
const delivered = projects.filter((p) => p.status === 'receptionne')
const building = projects.filter((p) => p.status === 'execution')
const [biggest] = publishedOnly(projects, ['villa-palmeras']).filter((p) => p.status === 'execution' && p.highlight)
const named = (p: Project) => (p.highlight ? `${p.name}${colon(lang)}${p.highlight.value} ${p.highlight.unit}` : p.name)
const figures: { value: number; label: string; context?: string }[] = [
  { value: 2016, label: t('fig.since') },
  { value: projects.length, label: t('fig.projects') },
  {
    value: delivered.length,
    label: t(delivered.length > 1 ? 'fig.delivered.many' : 'fig.delivered.one'),
    context: delivered.length <= 2 ? delivered.map(named).join(', ') : undefined,
  },
  {
    value: building.length,
    label: t(building.length > 1 ? 'fig.building.many' : 'fig.building.one'),
    context: biggest?.highlight
      ? `${t('fig.including')} ${biggest.name}, ${biggest.highlight.value} ${biggest.highlight.unit} ${lang === 'fr' ? 'à' : 'in'} ${biggest.location}`
      : undefined,
  },
].filter((f) => f.value > 0)
---

<section id="intro" class="theme-paper relative overflow-hidden py-24 md:py-40" aria-labelledby="intro-title">
  <div class="wrap grid gap-16 md:grid-cols-12">
    <div class="md:col-span-7">
      <h2 id="intro-title" class="display text-3xl">{t('intro.statement')}</h2>
      <p class="mt-10 max-w-xl text-lg leading-relaxed text-brand/75 md:text-lg">{t('intro.text')}</p>
      <a href={route('about', lang)} class="btn btn-line-dark mt-10">{t('cta.discover')} GCG <Icon name="arrow" size={20} /></a>
    </div>

    <div class="relative hidden md:col-span-5 md:block" aria-hidden="true">
      <div class="absolute right-0 top-0 w-[78%] overflow-hidden" data-reveal>
        <ProjectImage image={a} alt="" sizes="35vw" class="block aspect-[4/5]" />
        <ImageKind image={a} lang={lang} />
      </div>
      <div class="absolute bottom-[-6%] left-0 w-[52%] overflow-hidden border-8 border-paper" data-reveal>
        <ProjectImage image={b} alt="" sizes="25vw" class="block aspect-square" />
        <ImageKind image={b} lang={lang} />
      </div>
    </div>
  </div>

  <dl class="wrap mt-24 grid grid-cols-2 gap-x-6 gap-y-12 md:mt-36 md:grid-cols-4">
    {
      figures.map((f) => (
        <div class="flex flex-col border-t border-brand/15 pt-6">
          <dt class="meta order-2 mt-3 text-brand/75">{f.label}</dt>
          <dd class="display order-1 text-4xl text-brand">{f.value}</dd>
          {f.context && <dd class="order-3 mt-2 max-w-[30ch] text-sm leading-snug text-brand/75">{f.context}</dd>}
        </div>
      ))
    }
  </dl>
</section>

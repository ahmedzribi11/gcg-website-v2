---
import ProjectImage from '../ProjectImage.astro'
import Icon from '../Icon.astro'
import { route, useT, type Lang } from '../../i18n'
import type { Project } from '../../lib/projects'

interface Props {
  lang: Lang
  projects: Project[]
}
const { lang, projects } = Astro.props
const t = useT(lang)
const by = (slug: string) => projects.find((p) => p.slug === slug)!
const a = by('green-city')
const b = by('villa-palmeras')
const figures = [
  { value: 2016, label: t('fig.since'), plain: true },
  { value: projects.length, label: t('fig.projects') },
  { value: 20, suffix: '+', label: t('fig.staff') },
  { value: 4, label: t('fig.poles') },
]
---

<section id="intro" class="theme-paper relative overflow-hidden py-24 md:py-40" aria-labelledby="intro-title">
  <div class="wrap grid gap-16 md:grid-cols-12">
    <div class="md:col-span-7">
      <p class="label text-brand/75" data-reveal>{t('intro.label')}</p>
      <h2 id="intro-title" class="display mt-8 text-[clamp(2.4rem,5.6vw,6rem)]" data-split>
        {lang === 'fr' ? 'Une seule équipe, de la première étude à la' : 'One team, from the first study to the'}
        <em class="serif">{lang === 'fr' ? 'remise des clés.' : 'keys.'}</em>
      </h2>
      <p class="mt-10 max-w-xl text-lg leading-relaxed text-brand/75 md:text-xl" data-reveal>{t('intro.text')}</p>
      <a href={route('about', lang)} class="btn btn-line-dark mt-10" data-reveal data-magnetic>{t('cta.discover')} GCG <Icon name="arrow" /></a>
    </div>

    <div class="relative hidden md:col-span-5 md:block" aria-hidden="true">
      <div class="absolute right-0 top-0 w-[78%] overflow-hidden" data-reveal="clip">
        <div data-parallax="6"><ProjectImage image={a.images[0]} alt="" sizes="35vw" class="block aspect-[4/5]" /></div>
      </div>
      <div class="absolute bottom-[-6%] left-0 w-[52%] overflow-hidden border-8 border-paper" data-reveal="clip" style="--d:.2s">
        <div data-parallax="10"><ProjectImage image={b.images[0]} alt="" sizes="25vw" class="block aspect-square" /></div>
      </div>
    </div>
  </div>

  <dl class="wrap mt-24 grid grid-cols-2 gap-x-6 gap-y-12 md:mt-36 md:grid-cols-4">
    {
      figures.map((f, i) => (
        <div class="flex flex-col border-t border-brand/15 pt-6" data-reveal style={`--d:${i * 0.08}s`}>
          <dt class="meta order-2 mt-3 text-brand/75">{f.label}</dt>
          <dd class="display order-1 text-[clamp(3.4rem,7vw,7.5rem)] text-brand">
            {f.plain ? f.value : <span data-count={f.value}>{f.value}</span>}
            {f.suffix}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

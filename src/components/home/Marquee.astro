---
import type { Lang } from '../../i18n'
import { highlights, type Project } from '../../lib/projects'

interface Props {
  lang: Lang
  projects: Project[]
}
const { projects } = Astro.props
/**
 * Rangée fixe de quatre chiffres clés, lue par les lecteurs d’écran (SLOP-14 : plus de bandeau défilant masqué).
 * Chiffres saisis dans les fiches projet (champ « Chiffre clé ») ; les quatre premiers rangs du bandeau sont
 * affichés, un projet non publié en est absent (CODE-03).
 */
// Projet en études ou d’études seulement : missions de GCG à côté du chiffre (COPY-02)
const items = highlights(projects, 'marqueeOrder')
  .slice(0, 4)
  .map(({ p, h }) => [h.marqueeName, p.status === 'etudes' || p.designOnly ? `${h.marqueeFigure} · ${p.missions.join(' · ')}` : h.marqueeFigure])
---

{
  items.length > 0 && (
    <div class="border-y border-line bg-ink">
      <ul class="wrap grid grid-cols-2 gap-x-6 gap-y-5 py-6 md:grid-cols-4">
        {items.map(([name, figure]) => (
          <li class="flex flex-col gap-1.5">
            <span class="text-lg tracking-[-0.01em] text-bone/85">{name}</span>
            <span class="meta text-gold">{figure}</span>
          </li>
        ))}
      </ul>
    </div>
  )
}

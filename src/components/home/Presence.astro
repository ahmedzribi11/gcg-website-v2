---
import PresenceMap from '../PresenceMap.astro'
import Icon from '../Icon.astro'
import { cities, type CityId } from '../../data/geo'
import { route, useT, type Lang } from '../../i18n'
import type { Project } from '../../lib/projects'

interface Props {
  lang: Lang
  projects: Project[]
}
const { lang, projects } = Astro.props
const t = useT(lang)
const counts = projects.reduce<Record<string, number>>((a, p) => ((a[p.city] = (a[p.city] ?? 0) + 1), a), {})
const order = (Object.keys(counts) as CityId[]).sort((a, b) => counts[b] - counts[a])
---

<section class="theme-paper relative overflow-hidden py-24 md:py-40" aria-labelledby="presence-title">
  <div class="wrap grid gap-16 md:grid-cols-12 md:items-center">
    <div class="md:col-span-5">
      <p class="label text-brand/75" data-reveal>{t('presence.label')}</p>
      <h2 id="presence-title" class="display mt-8 text-[clamp(2.6rem,6vw,6.4rem)]" data-split>
        {lang === 'fr' ? 'De Korhogo' : 'From Korhogo'} <em class="serif">{lang === 'fr' ? 'à Assinie.' : 'to Assinie.'}</em>
      </h2>
      <p class="mt-8 max-w-md text-lg leading-relaxed text-brand/70" data-reveal>{t('presence.lead')}</p>
      <ul class="mt-10 border-t border-brand/15">
        {
          order.map((c, i) => (
            <li class="border-b border-brand/15" data-reveal style={`--d:${i * 0.05}s`}>
              <a href={`${route('projects', lang)}?ville=${c}`} class="group flex items-baseline justify-between py-3.5">
                <span class="text-lg font-light transition-transform duration-500 group-hover:translate-x-1.5">{cities[c].name}</span>
                <span class="meta text-brand/75">{String(counts[c]).padStart(2, '0')} {counts[c] > 1 ? t('projects.count.many') : t('projects.count.one')}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-10 flex items-center gap-3 text-[15px] text-brand/80" data-reveal>
        <Icon name="pin" size={18} class="text-gold-deep" />
        <em class="serif text-xl">{t('presence.ambition')}</em>
      </p>
    </div>
    <div class="md:col-span-7">
      <PresenceMap lang={lang} projects={projects} tone="paper" />
    </div>
  </div>
</section>

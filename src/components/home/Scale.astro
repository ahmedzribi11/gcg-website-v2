---
import SectionHead from '../SectionHead.astro'
import { colon, projectPath, STATUS_SHORT, useT, type Lang } from '../../i18n'
import { highlights, type Project } from '../../lib/projects'

interface Props {
  lang: Lang
  projects: Project[]
}
const { lang, projects } = Astro.props
const t = useT(lang)
const fr = lang === 'fr'
/** Chiffres clés saisis dans les fiches projet (champ « Chiffre clé », rang dans la grille) ; un projet non publié en est absent (CODE-03, OPS-02). */
const shown = highlights(projects, 'scaleOrder')
/**
 * Titre bâti sur deux projets avec travaux (COPY-02), et non sur une étude : la villa de luxe d’Assouindé et les
 * 116 villas de Villa Palmeras, chiffres lus dans leur fiche. Si l’un n’est pas publié, titre sans chiffre.
 */
const small = projects.find((p) => p.slug === 'villa-de-luxe-assouinde')?.highlight
const large = projects.find((p) => p.slug === 'villa-palmeras')?.highlight
const title = small && large ? (fr ? `De la villa de ${small.value} ${small.unit} au programme de ${large.value} ${large.unit}.` : `From a ${small.value} ${small.unit} villa to a programme of ${large.value} ${large.unit}.`) : t('scale.title')
/** Projet en études ou d’études seulement : le rôle de GCG est écrit à côté du chiffre (COPY-02). */
const studyOnly = (p: Project) => p.status === 'etudes' || p.designOnly
---

<section class="relative overflow-hidden bg-ink-2 py-24 md:py-40" aria-labelledby="scale-title">
  <div class="wrap">
    <SectionHead id="scale-title" title={title} lead={t('scale.lead')} size="md" />

    <ul class="mt-16 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-3 md:mt-24">
      {
        shown.map(({ p, h: it }) => {
          return (
            <li class="bg-ink-2" data-reveal>
              <a href={projectPath(p.slug, lang)} class="group flex h-full flex-col justify-between gap-10 p-7 transition-colors duration-500 hover:bg-ink-3 md:p-10">
                <div class="flex items-center justify-between gap-4">
                  <span class="meta text-mist">{p.name}</span>
                  {p.status && <span class="pill" data-status={p.status}>{STATUS_SHORT[p.status][lang]}</span>}
                  {!p.status && p.designOnly && <span class="pill" data-scope="design">{t('project.designOnly')}</span>}
                </div>
                <div>
                  <p class="flex flex-wrap items-baseline gap-x-3">
                    <span class="display whitespace-nowrap text-4xl text-gold">{it.value}</span>
                    <span class="text-lg text-bone/80 md:text-xl">{it.unit}</span>
                  </p>
                  <p class="mt-3 text-sm text-bone/55">{it.note ? `${it.note} · ${p.location}` : p.location}</p>
                  {studyOnly(p) && <p class="mt-1 text-sm text-bone/55">{`${t('project.missions')}${colon(lang)}${p.missions.join(', ')}`}</p>}
                </div>
              </a>
            </li>
          )
        })
      }
    </ul>
  </div>
</section>

---
import SectionHead from '../SectionHead.astro'
import { route, TYPE_LABELS, useT, type Lang } from '../../i18n'
import type { Project } from '../../lib/projects'
import { TYPES } from '../../content.config'

interface Props {
  lang: Lang
  projects: Project[]
}
const { lang, projects } = Astro.props
const t = useT(lang)
const count = (type: string) => projects.filter((p) => p.types.includes(type as never)).length
---

<section class="theme-brand relative overflow-hidden py-24 md:py-40" aria-labelledby="types-title">
  <div class="wrap">
    <SectionHead id="types-title" label={t('types.label')} title={t('types.title')} accent={lang === 'fr' ? 'un hôtel.' : 'a hotel.'} lead={t('types.lead')} tone="brand" size="md" />

    <ul class="mt-16 flex flex-wrap items-baseline gap-x-[0.55em] gap-y-1 md:mt-24" aria-label={t('types.label')}>
      {
        TYPES.map((type) => (
          <li>
            <a href={`${route('projects', lang)}?type=${type}`} class="type-word group inline-flex items-start gap-1 text-[clamp(min(2.6rem,12vw),8.4vw,8.8rem)] font-light leading-[1.02] tracking-[-0.05em] text-bone/55 transition-colors duration-500 hover:text-gold">
              <span>{TYPE_LABELS[type][lang]}</span>
              <sup class="meta mt-[0.6em] text-gold opacity-80">{String(count(type)).padStart(2, '0')}</sup>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
---

<Base lang="fr" alt="/en" title="Page introuvable / Page not found" noindex>
  <section class="relative flex min-h-svh items-center overflow-hidden">
    <div class="wrap relative">
      <p class="label text-gold">Erreur 404 / <span lang="en">Error 404</span></p>
      <h1 class="display mt-8 text-4xl">Page introuvable.</h1>
      <p class="display mt-3 text-2xl md:text-3xl text-bone/60" lang="en">Page not found.</p>
      <p class="mt-6 max-w-lg text-lg text-bone/70">Cette page n’existe pas ou a été déplacée. <span lang="en">This page does not exist or has moved.</span></p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/" class="btn btn-gold">Accueil <Icon name="arrow" size={20} /></a>
        <a href="/realisations" class="btn btn-line">Réalisations</a>
        <a href="/en" class="btn btn-line" lang="en">Home (English)</a>
        <a href="/en/projects" class="btn btn-line" lang="en">Projects</a>
      </div>
    </div>
  </section>
  <script>
    // Adresse de QR code imprimé inconnue (/qr/…, /q/…, SHR-03, SHR-04) : jamais de page introuvable, retour à l’accueil
    if (/^\/qr?(\/|$)/.test(location.pathname)) location.replace((/^\/qr?\/en(\/|$)/.test(location.pathname) ? '/en' : '/') + '?utm_source=qr&utm_medium=inconnu')
  </script>
</Base>

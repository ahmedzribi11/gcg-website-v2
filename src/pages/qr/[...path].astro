---
/**
 * Adresses permanentes des QR codes imprimés (CONV-11, ANA-03) : le QR code encode toujours
 * https://<domaine GCG>/qr/…, et cette page redirige vers la bonne page avec le marquage de campagne.
 * La destination peut évoluer sans réimprimer les panneaux, cartes et brochures.
 *   /qr, /qr/panneau, /qr/carte, /qr/brochure      → accueil FR
 *   /qr/en, /qr/en/panneau, …                      → accueil EN
 *   /qr/p/<projet>, /qr/en/p/<projet>              → page du projet (panneau de chantier)
 *   … projet non publié (autorisation en attente, anglais non relu) → liste des réalisations (SHR-03)
 *   … projet retiré (dans le registre src/data/published-slugs.json, fiche supprimée) → son ancienne
 *     adresse, que la redirection exigée par scripts/check-content.mjs envoie vers la bonne page
 *   /qr/instagram, /qr/facebook, …                 → réseaux sociaux renseignés dans les paramètres
 *   toute autre adresse /qr/… inconnue             → accueil, par le script de la page 404
 */
import { getCollection } from 'astro:content'
import { projectPath, route, type Lang } from '../../i18n'
import { getProjects } from '../../lib/projects'
import registry from '../../data/published-slugs.json'
import { socials } from '../../lib/settings'

export async function getStaticPaths() {
  const MEDIA = ['qr', 'panneau', 'carte', 'brochure'] as const
  const utm = (medium: string, campaign: string) => `utm_source=qr&utm_medium=${medium}&utm_campaign=${campaign}`
  const paths: { params: { path: string | undefined }; props: { to: string } }[] = []
  // Un code imprimé ne doit jamais mener à une page introuvable : une adresse par fiche, publiée ou non, et par projet retiré
  const entries = (await getCollection('projects')).map((e) => e.id)
  const slugs = [...new Set([...entries, ...registry])].sort()
  for (const lang of ['fr', 'en'] as Lang[]) {
    const pre = lang === 'fr' ? '' : 'en'
    for (const m of MEDIA) {
      const p = [pre, m === 'qr' ? '' : m].filter(Boolean).join('/')
      paths.push({ params: { path: p || undefined }, props: { to: `${route('home', lang)}?${utm(m, 'site')}` } })
    }
    const published = new Set((await getProjects(lang)).map((p) => p.slug))
    for (const slug of slugs) {
      const page = published.has(slug) || !entries.includes(slug) ? projectPath(slug, lang) : route('projects', lang)
      paths.push({ params: { path: [pre, 'p', slug].filter(Boolean).join('/') }, props: { to: `${page}?${utm('panneau', 'projet')}` } })
    }
  }
  for (const s of socials) paths.push({ params: { path: s.key }, props: { to: s.url } })
  return paths
}

const { to } = Astro.props
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <title>GCG Côte d’Ivoire</title>
  </head>
  <body>
    <p><a href={to}>General Constructor Group CI</a></p>
  </body>
</html>

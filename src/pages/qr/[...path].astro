---
/**
 * Adresses permanentes des QR codes imprimés (CONV-11, ANA-03) : le QR code encode toujours
 * https://<domaine GCG>/qr/…, et cette page redirige vers la bonne page avec le marquage de campagne.
 * La destination peut évoluer sans réimprimer les panneaux, cartes et brochures.
 *   /qr, /qr/panneau, /qr/carte, /qr/brochure      → accueil FR
 *   /qr/en, /qr/en/panneau, …                      → accueil EN
 *   /qr/p/<projet>, /qr/en/p/<projet>              → page du projet (panneau de chantier)
 *   /qr/instagram, /qr/facebook, …                 → réseaux sociaux renseignés dans les paramètres
 */
import { projectPath, route, type Lang } from '../../i18n'
import { getProjects } from '../../lib/projects'
import { socials } from '../../lib/settings'

export async function getStaticPaths() {
  const MEDIA = ['qr', 'panneau', 'carte', 'brochure'] as const
  const utm = (medium: string, campaign: string) => `utm_source=qr&utm_medium=${medium}&utm_campaign=${campaign}`
  const paths: { params: { path: string | undefined }; props: { to: string } }[] = []
  for (const lang of ['fr', 'en'] as Lang[]) {
    const pre = lang === 'fr' ? '' : 'en'
    for (const m of MEDIA) {
      const p = [pre, m === 'qr' ? '' : m].filter(Boolean).join('/')
      paths.push({ params: { path: p || undefined }, props: { to: `${route('home', lang)}?${utm(m, 'site')}` } })
    }
    for (const proj of await getProjects(lang)) {
      paths.push({ params: { path: [pre, 'p', proj.slug].filter(Boolean).join('/') }, props: { to: `${projectPath(proj.slug, lang)}?${utm('panneau', 'projet')}` } })
    }
  }
  for (const s of socials) paths.push({ params: { path: s.key }, props: { to: s.url } })
  return paths
}

const { to } = Astro.props
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <title>GCG Côte d’Ivoire</title>
  </head>
  <body>
    <p><a href={to}>General Constructor Group CI</a></p>
  </body>
</html>

---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import ProjectImage from '../components/ProjectImage.astro'
import PresenceMap from '../components/PresenceMap.astro'
import FinalCta from '../components/FinalCta.astro'
import { competences, equipment, keyFigures, poles, totalQty, vehicles } from '../data/organisation'
import { projectPath, route, useT, type Lang } from '../i18n'
import { getProjects, pad } from '../lib/projects'
import { media, videoEmbed } from '../lib/settings'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)
const fr = lang === 'fr'
const projects = await getProjects(lang)
const by = (slug: string) => projects.find((p) => p.slug === slug)!

// Historique : projets par année de démarrage
const years: number[] = []
for (let y = 2016; y <= Math.max(...projects.map((p) => p.year)); y++) years.push(y)
const byYear = (y: number) => projects.filter((p) => p.year === y)
const video = videoEmbed(media.videoUrl)
---

<Base lang={lang} alt={route('about', fr ? 'en' : 'fr')} title={t('about.label')} description={t('about.lead')}>
  <PageHeader label={t('about.label')} title={t('about.title')} accent={fr ? 'depuis 2016.' : 'since 2016.'} lead={t('about.lead')} />

  <section class="theme-paper py-24 md:py-36" aria-label={t('about.label')}>
    <div class="wrap grid gap-16 md:grid-cols-12">
      <div class="md:col-span-6">
        <p class="serif text-[clamp(5rem,14vw,13rem)] leading-none text-brand" data-reveal>2016</p>
        <p class="mt-10 max-w-xl text-xl font-light leading-relaxed md:text-2xl" data-reveal>{t('about.p2')}</p>
        <p class="mt-6 max-w-xl text-[15px] leading-relaxed text-brand/70" data-reveal>{t('about.team')}</p>
      </div>
      <div class="grid grid-cols-2 gap-3 md:col-span-6" aria-hidden="true">
        <div class="col-span-2 overflow-hidden" data-reveal="clip"><div data-parallax="5"><ProjectImage image={by('residence-privee-beverly-hills').images[0]} alt="" sizes="(min-width: 768px) 45vw, 100vw" class="block aspect-[16/10]" /></div></div>
        <div class="overflow-hidden" data-reveal="clip" style="--d:.15s"><ProjectImage image={by('green-city').images[2]} alt="" sizes="(min-width: 768px) 22vw, 50vw" class="block aspect-square" /></div>
        <div class="overflow-hidden" data-reveal="clip" style="--d:.3s"><ProjectImage image={by('hotel-calao-korhogo').images[0]} alt="" sizes="(min-width: 768px) 22vw, 50vw" class="block aspect-square" /></div>
      </div>
    </div>
  </section>

  {
    video && (
      <section class="wrap py-24 md:py-32" aria-label={t('about.video')}>
        <p class="label text-gold" data-reveal>{t('about.video')}</p>
        <div class="mt-8 aspect-video overflow-hidden bg-ink-3" data-reveal>
          {video.kind === 'iframe' ? (
            <iframe src={video.src} title={t('about.video')} class="h-full w-full" loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen />
          ) : (
            <video src={video.src} controls preload="metadata" playsinline class="h-full w-full object-cover" />
          )}
        </div>
      </section>
    )
  }

  <!-- Historique -->
  <section class="py-24 md:py-40" aria-labelledby="history-title">
    <div class="wrap">
      <p class="label text-gold" data-reveal>{t('about.history.label')}</p>
      <div class="mt-8 grid gap-8 md:grid-cols-12 md:items-end">
        <h2 id="history-title" class="display text-[clamp(2.4rem,5.6vw,6rem)] md:col-span-8" data-split>{t('about.history.title')}</h2>
        <p class="max-w-md text-[15px] leading-relaxed text-bone/60 md:col-span-4" data-reveal>{t('about.history.lead')}</p>
      </div>

      <ol class="mt-16 border-t border-line md:mt-24">
        {
          years.map((y) => {
            const list = byYear(y)
            return (
              <li class="grid gap-4 border-b border-line py-8 md:grid-cols-12 md:gap-8 md:py-10" data-reveal>
                <p class="display text-[clamp(2.6rem,5vw,5rem)] text-gold md:col-span-3">{y}</p>
                <div class="md:col-span-9">
                  {y === 2016 && list.length === 0 ? (
                    <p class="pt-2 text-xl font-light text-bone/80 md:text-2xl">{fr ? 'Création de General Constructor Group en Côte d’Ivoire.' : 'General Constructor Group is founded in Côte d’Ivoire.'}</p>
                  ) : list.length === 0 ? (
                    <p class="pt-3 text-bone/40">—</p>
                  ) : (
                    <ul class="flex flex-wrap gap-2 pt-2">
                      {list.map((p) => (
                        <li>
                          <a href={projectPath(p.slug, lang)} class="group flex items-center gap-3 rounded-full border border-line py-1.5 pl-1.5 pr-4 transition-colors hover:border-gold" data-cursor="view">
                            <ProjectImage image={p.images[0]} alt="" sizes="2.5rem" class="block h-9 w-9 overflow-hidden rounded-full" />
                            <span class="text-[14px] text-bone/85 group-hover:text-bone">{p.name}</span>
                            <span class="meta text-mist">{pad(p.number)}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            )
          })
        }
      </ol>
    </div>
  </section>

  <!-- Organisation -->
  <section class="bg-ink-2 py-24 md:py-40" aria-labelledby="org-title">
    <div class="wrap">
      <p class="label text-gold" data-reveal>{t('about.org.label')}</p>
      <h2 id="org-title" class="display mt-8 max-w-[22ch] text-[clamp(2.2rem,5vw,5.4rem)]" data-split>{t('about.org.title')}</h2>

      <dl class="mt-16 grid grid-cols-2 gap-x-6 gap-y-12 md:mt-24 md:grid-cols-4">
        {
          keyFigures.map((f, i) => (
            <div class="flex flex-col border-t border-line pt-6" data-reveal style={`--d:${i * 0.08}s`}>
              <dt class="meta order-2 mt-3 text-mist">{f.label[lang]}</dt>
              <dd class="display order-1 text-[clamp(3.6rem,7.5vw,8rem)] text-gold">
                <span data-count={f.value}>{f.value}</span>
                {f.suffix}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-24 grid gap-16 md:mt-32 md:grid-cols-12">
        <div class="md:col-span-5">
          <h3 class="meta text-mist" data-reveal>{t('about.org.poles')}</h3>
          <ul class="mt-6 border-t border-line">
            {
              poles.map((p, i) => (
                <li class="grid grid-cols-[1fr_auto] gap-x-6 border-b border-line py-5" data-reveal style={`--d:${i * 0.05}s`}>
                  <span class="text-xl font-light">{fr ? 'Pôle' : ''} {p.name[lang]}</span>
                  <span class="meta pt-1.5 text-gold">{p.team} {t('about.org.staff')}</span>
                  <span class="col-span-2 mt-1 text-[14px] text-bone/55">{p.role[lang]}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="md:col-span-6 md:col-start-7">
          <h3 class="meta text-mist" data-reveal>{t('about.org.skills')}</h3>
          <div class="mt-6 grid grid-cols-2 gap-x-6 gap-y-10 border-t border-line pt-6">
            {
              competences.map((c, i) => (
                <div data-reveal style={`--d:${i * 0.05}s`}>
                  <p class="text-2xl font-light tracking-[-0.02em]">{c.name[lang]}</p>
                  <ul class="mt-3 space-y-1.5">
                    {c.items[lang].map((it) => (
                      <li class="flex items-center gap-3 text-[14px] text-bone/60">
                        <span class="h-px w-3 bg-gold/60" aria-hidden="true" />
                        {it}
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Moyens matériels -->
  <section class="py-24 md:py-40" aria-labelledby="means-title">
    <div class="wrap">
      <p class="label text-gold" data-reveal>{t('about.means.label')}</p>
      <div class="mt-8 grid gap-8 md:grid-cols-12 md:items-end">
        <h2 id="means-title" class="display text-[clamp(2.2rem,5vw,5.4rem)] md:col-span-8" data-split>{t('about.means.title')}</h2>
        <p class="max-w-md text-[15px] leading-relaxed text-bone/60 md:col-span-4" data-reveal>{t('about.means.lead')}</p>
      </div>
      <div class="mt-16 grid gap-14 md:mt-24 md:grid-cols-3 md:gap-10">
        {
          equipment.map((g) => (
            <div data-reveal>
              <div class="flex items-baseline justify-between border-b border-bone/30 pb-4">
                <h3 class="text-2xl font-light tracking-[-0.02em]">{g.name[lang]}</h3>
                <span class="meta text-mist">{pad(totalQty(g.items))} {t('about.means.units')}</span>
              </div>
              <ul>
                {g.items.map((it) => (
                  <li class="flex items-baseline justify-between gap-6 border-b border-line py-3.5">
                    <span class="text-[15px] text-bone/85">{it.name}</span>
                    <span class="font-mono text-[13px] text-gold">{pad(it.qty)}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div data-reveal>
          <div class="flex items-baseline justify-between border-b border-bone/30 pb-4">
            <h3 class="text-2xl font-light tracking-[-0.02em]">{fr ? 'Véhicules' : 'Vehicles'}</h3>
            <span class="meta text-mist">{pad(totalQty(vehicles))} {t('about.means.units')}</span>
          </div>
          <ul>
            {
              vehicles.map((v) => (
                <li class="flex items-baseline justify-between gap-6 border-b border-line py-3.5">
                  <span class="text-[15px] text-bone/85">{v.name[lang]}</span>
                  <span class="font-mono text-[13px] text-gold">{pad(v.qty)}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Présence -->
  <section class="theme-paper py-24 md:py-40" aria-labelledby="where-title">
    <div class="wrap grid gap-16 md:grid-cols-12 md:items-center">
      <div class="md:col-span-5">
        <p class="label text-brand/75" data-reveal>{t('presence.label')}</p>
        <h2 id="where-title" class="display mt-8 text-[clamp(2.4rem,5.6vw,6rem)]" data-split>
          {fr ? 'De Korhogo' : 'From Korhogo'} <em class="serif">{fr ? 'à Assinie.' : 'to Assinie.'}</em>
        </h2>
        <p class="mt-8 max-w-md text-lg leading-relaxed text-brand/70" data-reveal>{t('presence.lead')}</p>
        <p class="serif mt-10 max-w-md text-[clamp(1.6rem,2.6vw,2.4rem)] leading-tight text-brand" data-reveal>{t('presence.ambition')}</p>
      </div>
      <div class="md:col-span-7">
        <PresenceMap lang={lang} projects={projects} tone="paper" />
      </div>
    </div>
  </section>

  <FinalCta lang={lang} />
</Base>

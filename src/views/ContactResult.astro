---
/**
 * Pages d’arrivée du formulaire envoyé sans JavaScript : merci, ou une page d’erreur par cause (PERF-15, UX-07, OPS-05) :
 * champ manquant (le bouton Précédent garde la saisie), trop d’envois (attendre 10 minutes, la fenêtre de
 * server/contact.js), envoi impossible (WhatsApp ou téléphone).
 */
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { route, useT, type Lang } from '../i18n'
import { contact, pageWhatsApp } from '../lib/settings'

interface Props {
  lang: Lang
  kind: 'thanks' | 'formError' | 'formRate' | 'formFailed'
}
const { lang, kind } = Astro.props
const t = useT(lang)
const ok = kind === 'thanks'
const text = { thanks: t('contact.form.okText'), formError: t('contact.result.invalid'), formRate: t('contact.result.rate'), formFailed: t('contact.result.failed') }[kind]
const wa = pageWhatsApp(lang, t('contact.label'))
---

<Base lang={lang} alt={route(kind, lang === 'fr' ? 'en' : 'fr')} title={ok ? t('contact.form.okTitle') : t('contact.form.failTitle')} noindex>
  <section class="wrap max-w-3xl pb-28 pt-36 md:pt-48">
    <p class="label text-gold">{t('contact.label')}</p>
    <h1 class="display mt-8 text-[clamp(2.8rem,8vw,6rem)]">{ok ? t('contact.form.okTitle') : t('contact.form.failTitle')}</h1>
    <p class="mt-8 text-lg text-bone/85">{text}</p>
    <div class="mt-10 flex flex-wrap gap-3">
      {wa && <a href={wa} target="_blank" rel="noopener" class="btn btn-gold"><Icon name="whatsapp" size={20} /> WhatsApp</a>}
      {contact.phone && <a href={contact.phoneHref} class="btn btn-line"><Icon name="phone" size={20} /> {contact.phone}</a>}
      {contact.email && <a href={`mailto:${contact.email}`} class="btn btn-line"><Icon name="mail" size={20} /> {contact.email}</a>}
      <a href={ok ? route('projects', lang) : `${route('contact', lang)}#brief`} class="btn btn-line">{ok ? t('cta.allProjects') : t('cta.project')} <Icon name="arrow" size={20} /></a>
    </div>
  </section>
</Base>

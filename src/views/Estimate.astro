---
/**
 * Devis estimatif (demande de M. Chebbi, 24 octobre 2026) : le visiteur obtient une fourchette de prix
 * et ses coordonnées sont transmises à GCG à chaque demande (server/contact.js, kind = « devis »).
 * Les montants se règlent dans src/data/estimate.json (modifiable dans /admin) ; calcul : src/lib/estimate.js.
 */
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { route, type Lang } from '../i18n'
import { contact } from '../lib/settings'
import { contactFormEnabled } from '../lib/env'
import { availableOptions, MAX_AREA, PROJECT_TYPES } from '../lib/estimate.js'
import cfg from '../data/estimate.json'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const fr = lang === 'fr'
const opts = availableOptions(cfg)

const typeLabel: Record<string, { fr: string; en: string }> = {
  villa: { fr: 'Villa', en: 'Villa' },
  immeuble: { fr: 'Immeuble', en: 'Apartment building' },
  'local-commercial': { fr: 'Local commercial', en: 'Commercial premises' },
  autre: { fr: 'Autre', en: 'Other' },
}
const T = fr
  ? {
      label: 'Devis estimatif',
      title: 'Estimez le coût de',
      accent: 'votre projet.',
      lead: 'Quelques informations suffisent pour obtenir une première fourchette de prix. Un ingénieur GCG-CI vous recontacte ensuite.',
      nom: 'Nom',
      prenom: 'Prénom',
      phone: 'Téléphone / WhatsApp',
      email: 'E-mail',
      type: 'Type de projet',
      terrain: 'Surface du terrain (m²)',
      constructible: 'Surface constructible (m²)',
      constructibleHint: 'Si vous la connaissez.',
      piscine: 'Piscine',
      cloture: 'Clôture',
      etudes: 'Études et permis de construire',
      oui: 'Oui',
      non: 'Non',
      tooBig: 'La surface constructible dépasse la surface du terrain. Vérifiez les valeurs : un projet sur plusieurs niveaux peut le justifier.',
      submit: 'Obtenir mon estimation',
      sending: 'Envoi en cours…',
      result: 'Estimation entre {low} et {high} FCFA',
      mention:
        'Ce devis est purement estimatif et n’a aucune valeur contractuelle. Un ingénieur GCG-CI vous contactera pour établir un devis détaillé selon votre terrain et vos besoins.',
      again: 'Modifier ma demande',
      waSend: 'Envoyer à GCG par WhatsApp',
      failTitle: 'La demande n’a pas pu être envoyée.',
      failText: 'Réessayez dans un instant, ou envoyez-la par WhatsApp.',
      rate: 'Trop de demandes envoyées depuis cette connexion. Réessayez dans quelques minutes, ou envoyez-la par WhatsApp.',
      notice: 'Vos informations servent uniquement à répondre à votre demande et sont transmises à l’équipe commerciale de GCG.',
      noticeLink: 'Politique de confidentialité',
      honeypot: 'Ne pas remplir ce champ',
      waIntro: 'Bonjour GCG, voici ma demande de devis estimatif.',
      unit: 'm²',
      required: 'champ obligatoire',
      description: 'Obtenez une première fourchette de prix pour votre villa, immeuble ou local commercial en Côte d’Ivoire. Un ingénieur GCG-CI vous recontacte.',
    }
  : {
      label: 'Cost estimate',
      title: 'Estimate the cost of',
      accent: 'your project.',
      lead: 'A few details are enough to get a first price range. A GCG-CI engineer will then get back to you.',
      nom: 'Last name',
      prenom: 'First name',
      phone: 'Phone / WhatsApp',
      email: 'Email',
      type: 'Project type',
      terrain: 'Plot area (m²)',
      constructible: 'Buildable area (m²)',
      constructibleHint: 'If you know it.',
      piscine: 'Swimming pool',
      cloture: 'Boundary wall',
      etudes: 'Design studies and building permit',
      oui: 'Yes',
      non: 'No',
      tooBig: 'The buildable area is larger than the plot. Check the figures: a project on several floors can explain it.',
      submit: 'Get my estimate',
      sending: 'Sending…',
      result: 'Estimate between {low} and {high} FCFA',
      mention:
        'This estimate is for guidance only and has no contractual value. A GCG-CI engineer will contact you to prepare a detailed quote based on your plot and your needs.',
      again: 'Change my request',
      waSend: 'Send to GCG on WhatsApp',
      failTitle: 'Your request could not be sent.',
      failText: 'Try again in a moment, or send it on WhatsApp.',
      rate: 'Too many requests from this connection. Try again in a few minutes, or send it on WhatsApp.',
      notice: 'Your details are used only to answer your request and are passed on to GCG’s sales team.',
      noticeLink: 'Privacy policy',
      honeypot: 'Leave this field empty',
      waIntro: 'Hello GCG, here is my cost estimate request.',
      unit: 'm²',
      required: 'required',
      description: 'Get a first price range for your villa, apartment building or commercial premises in Côte d’Ivoire. A GCG-CI engineer will get back to you.',
    }
const field = 'mt-2 w-full rounded-none border-0 border-b border-line bg-transparent px-0 py-3 text-lg font-light text-bone placeholder:text-bone/30 focus:border-gold focus:outline-none focus:ring-0'
const options = (['piscine', 'cloture', 'etudes'] as const).filter((k) => opts[k])
---

<Base lang={lang} alt={route('estimate', fr ? 'en' : 'fr')} title={T.label} description={T.description}>
  <section class="relative overflow-hidden pb-24 pt-32 md:pb-36 md:pt-48">
    <div class="absolute inset-0" aria-hidden="true">
      <div class="css-fog opacity-60"><span></span><span></span><span></span></div>
    </div>
    <div class="wrap relative grid gap-16 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="label text-gold" data-reveal>{T.label}</p>
        <h1 class="display mt-8 text-[clamp(2.8rem,7vw,7rem)]" data-split>
          {T.title} <em class="serif text-gold">{T.accent}</em>
        </h1>
        <p class="mt-8 max-w-md text-lg leading-relaxed text-bone/70" data-reveal>{T.lead}</p>
      </div>

      <form id="estimate" action="/api/contact" method="post" class="md:col-span-6 md:col-start-7" novalidate data-enabled={contactFormEnabled ? '' : undefined} data-reveal>
        <div class="grid gap-x-8 gap-y-8 border border-line bg-ink/70 p-6 backdrop-blur-xl md:grid-cols-2 md:p-10">
          <label class="block">
            <span class="meta text-mist">{T.nom} *</span>
            <input name="nom" required autocomplete="family-name" maxlength="60" class={field} />
          </label>
          <label class="block">
            <span class="meta text-mist">{T.prenom} *</span>
            <input name="prenom" required autocomplete="given-name" maxlength="60" class={field} />
          </label>
          <label class="block md:col-span-2">
            <span class="meta text-mist">{T.type} *</span>
            <select name="type" required class={`${field} cursor-pointer`}>
              {PROJECT_TYPES.map((p) => <option value={p} class="bg-ink">{typeLabel[p][lang]}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="meta text-mist">{T.terrain} *</span>
            <input name="terrain" type="number" required min="1" max={MAX_AREA} step="1" inputmode="numeric" class={field} />
          </label>
          <label class="block">
            <span class="meta text-mist">{T.constructible}</span>
            <input name="constructible" type="number" min="1" max={MAX_AREA} step="1" inputmode="numeric" aria-describedby="constructible-hint" class={field} />
            <span id="constructible-hint" class="mt-2 block text-[13px] text-bone/50">{T.constructibleHint}</span>
          </label>
          <p data-too-big hidden role="status" class="md:col-span-2 border-l border-gold/60 pl-4 text-[14px] text-bone/70">{T.tooBig}</p>
          {
            options.length > 0 && (
              <div class="grid gap-x-8 gap-y-8 sm:grid-cols-3 md:col-span-2">
                {options.map((k) => (
              <fieldset class="block">
                <legend class="meta text-mist">{T[k]}</legend>
                <div class="mt-4 flex gap-6 text-lg font-light">
                  <label class="flex cursor-pointer items-center gap-2">
                    <input type="radio" name={k} value="oui" class="accent-[var(--color-gold)]" /> {T.oui}
                  </label>
                  <label class="flex cursor-pointer items-center gap-2">
                    <input type="radio" name={k} value="non" checked class="accent-[var(--color-gold)]" /> {T.non}
                  </label>
                </div>
              </fieldset>
                ))}
              </div>
            )
          }
          <label class="block">
            <span class="meta text-mist">{T.phone} *</span>
            <input name="phone" type="tel" required autocomplete="tel" inputmode="tel" pattern="\+?[\d\s\(\)\.\-]{8,30}" class={field} />
          </label>
          <label class="block">
            <span class="meta text-mist">{T.email}</span>
            <input name="email" type="email" autocomplete="email" class={field} />
          </label>
          <input type="hidden" name="kind" value="devis" />
          <input type="hidden" name="low" value="" />
          <input type="hidden" name="high" value="" />
          <input type="hidden" name="lang" value={lang} />
          <input type="hidden" name="t" value="" />
          <div class="sr-only" aria-hidden="true">
            <label>{T.honeypot} <input name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <div class="md:col-span-2">
            <button type="submit" class="btn btn-gold w-full" data-send>
              <span data-send-label>{T.submit}</span> <Icon name="arrow" />
            </button>
          </div>
          <div data-fail hidden role="alert" class="md:col-span-2 border-l border-[#ff9b8a] pl-4 text-[14px] text-bone/80">
            <p class="font-medium text-bone">{T.failTitle}</p>
            <p class="mt-1" data-fail-text>{T.failText}</p>
            {
              contact.whatsappNumber && (
                <a data-wa-fallback href="#" target="_blank" rel="noopener" class="btn btn-line mt-4 whitespace-normal text-center">
                  <Icon name="whatsapp" size={18} /> {T.waSend}
                </a>
              )
            }
          </div>
          <p class="md:col-span-2 text-[13px] text-bone/50">
            {T.notice} <a href={route('privacy', lang)} class="link-line text-bone/70 hover:text-bone">{T.noticeLink}</a>
          </p>
        </div>
      </form>

      <div data-result hidden role="status" tabindex="-1" class="min-w-0 md:col-span-6 md:col-start-7 border border-gold/60 bg-ink/80 p-6 md:p-10">
        <p class="display text-3xl md:text-4xl" data-result-text></p>
        <p class="mt-6 text-[15px] leading-relaxed text-bone/70">{T.mention}</p>
        <div class="mt-8 flex flex-col gap-3">
          {
            !contactFormEnabled && contact.whatsappNumber && (
              <a data-wa-send href="#" target="_blank" rel="noopener" class="btn btn-gold whitespace-normal text-center">
                <Icon name="whatsapp" size={18} /> {T.waSend}
              </a>
            )
          }
          <button type="button" data-again class="btn btn-line whitespace-normal text-center">{T.again}</button>
        </div>
      </div>
    </div>
  </section>

  <script
    id="estimate-data"
    type="application/json"
    set:html={JSON.stringify({
      cfg,
      wa: contact.whatsappNumber,
      types: Object.fromEntries(PROJECT_TYPES.map((p) => [p, typeLabel[p][lang]])),
      labels: {
        sep: fr ? ' : ' : ': ',
        result: T.result,
        sending: T.sending,
        rate: T.rate,
        waIntro: T.waIntro,
        nom: T.nom,
        prenom: T.prenom,
        phone: T.phone,
        email: T.email,
        type: T.type,
        terrain: T.terrain,
        constructible: T.constructible,
        piscine: T.piscine,
        cloture: T.cloture,
        etudes: T.etudes,
        oui: T.oui,
        non: T.non,
      },
    })}
  />
  <script>
    import { track } from '../scripts/analytics'
    import { computeEstimate, formatAmount, parseArea } from '../lib/estimate.js'

    const form = document.getElementById('estimate') as HTMLFormElement
    const result = document.querySelector<HTMLElement>('[data-result]')!
    const data = JSON.parse(document.getElementById('estimate-data')!.textContent!) as {
      cfg: Parameters<typeof computeEstimate>[1]
      wa: string
      types: Record<string, string>
      labels: Record<string, string>
    }
    const L = data.labels
    const input = (name: string) => form.elements.namedItem(name) as HTMLInputElement | null
    const checked = (name: string) => (form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? 'non') === 'oui'

    // Délai minimal de saisie (anti-robots), vérifié par le serveur
    input('t')!.value = String(Date.now())

    // Avertissement (non bloquant) : surface constructible supérieure au terrain
    const tooBig = form.querySelector<HTMLElement>('[data-too-big]')!
    const checkSizes = () => {
      const terrain = parseArea(input('terrain')!.value)
      const constructible = parseArea(input('constructible')!.value)
      tooBig.hidden = !(terrain && constructible && constructible > terrain)
    }
    input('terrain')!.addEventListener('input', checkSizes)
    input('constructible')!.addEventListener('input', checkSizes)

    function estimate() {
      const r = computeEstimate(
        {
          terrain: parseArea(input('terrain')!.value) as number,
          constructible: parseArea(input('constructible')!.value),
          piscine: checked('piscine'),
          cloture: checked('cloture'),
          etudes: checked('etudes'),
        },
        data.cfg,
      )
      input('low')!.value = String(r.low)
      input('high')!.value = String(r.high)
      return L.result.replace('{low}', formatAmount(r.low)).replace('{high}', formatAmount(r.high))
    }

    /** Message WhatsApp prérempli : coordonnées, données saisies et fourchette. */
    function whatsappText(range: string) {
      const v = (name: string) => input(name)?.value.trim() ?? ''
      const yn = (name: string) => (form.querySelector(`input[name="${name}"]`) ? `${L[name]}${L.sep}${checked(name) ? L.oui : L.non}` : '')
      return [
        L.waIntro,
        '',
        `${L.nom}${L.sep}${v('nom')}`,
        `${L.prenom}${L.sep}${v('prenom')}`,
        `${L.phone}${L.sep}${v('phone')}`,
        v('email') ? `${L.email}${L.sep}${v('email')}` : '',
        `${L.type}${L.sep}${data.types[(form.elements.namedItem('type') as HTMLSelectElement).value]}`,
        `${L.terrain}${L.sep}${v('terrain')}`,
        v('constructible') ? `${L.constructible}${L.sep}${v('constructible')}` : '',
        yn('piscine'),
        yn('cloture'),
        yn('etudes'),
        '',
        range,
      ]
        .filter((l, i, a) => l !== '' || a[i - 1] !== '')
        .join('\n')
    }
    const waHref = (text: string) => `https://wa.me/${data.wa}?text=${encodeURIComponent(text)}`

    function showResult(range: string) {
      result.querySelector<HTMLElement>('[data-result-text]')!.textContent = range
      const wa = result.querySelector<HTMLAnchorElement>('[data-wa-send]')
      if (wa) wa.href = waHref(whatsappText(range))
      form.hidden = true
      result.hidden = false
      result.focus()
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (!form.reportValidity()) return
      const range = estimate()
      const fail = form.querySelector<HTMLElement>('[data-fail]')!
      fail.hidden = true
      if (form.dataset.enabled === undefined) {
        // Envoi par e-mail pas encore configuré : l’estimation s’affiche, l’envoi passe par WhatsApp
        track('estimate')
        showResult(range)
        return
      }
      const btn = form.querySelector<HTMLButtonElement>('[data-send]')!
      const label = form.querySelector<HTMLElement>('[data-send-label]')!
      const before = label.textContent
      btn.disabled = true
      label.textContent = L.sending
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        })
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; code?: string }
        if (!res.ok || !body.ok) throw new Error(body.code || String(res.status))
        track('estimate')
        showResult(range)
      } catch (err) {
        if ((err as Error).message === 'rate') form.querySelector<HTMLElement>('[data-fail-text]')!.textContent = L.rate
        const wa = form.querySelector<HTMLAnchorElement>('[data-wa-fallback]')
        if (wa) wa.href = waHref(whatsappText(range))
        fail.hidden = false
      } finally {
        btn.disabled = false
        label.textContent = before
      }
    })

    result.querySelector('[data-again]')!.addEventListener('click', () => {
      result.hidden = true
      form.hidden = false
      input('t')!.value = String(Date.now())
      input('terrain')!.focus()
    })
  </script>
</Base>

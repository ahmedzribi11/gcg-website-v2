---
import Base from '../layouts/Base.astro'
import Hero from '../components/home/Hero.astro'
import Marquee from '../components/home/Marquee.astro'
import Intro from '../components/home/Intro.astro'
import Services from '../components/home/Services.astro'
import Types from '../components/home/Types.astro'
import Featured from '../components/home/Featured.astro'
import Scale from '../components/home/Scale.astro'
import Presence from '../components/home/Presence.astro'
import Audiences from '../components/home/Audiences.astro'
import Method from '../components/Method.astro'
import FinalCta from '../components/FinalCta.astro'
import { route, type Lang } from '../i18n'
import { getFeatured, getProjects } from '../lib/projects'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const projects = await getProjects(lang)
const featured = await getFeatured(lang)
---

<Base lang={lang} alt={route('home', lang === 'fr' ? 'en' : 'fr')} header="overlay" organization docTitle={lang === 'fr' ? 'GCG · Construction & ingénierie en Côte d’Ivoire' : 'GCG · Construction & engineering in Côte d’Ivoire'}>
  <Hero lang={lang} />
  <Marquee lang={lang} />
  <Intro lang={lang} projects={projects} />
  <Services lang={lang} projects={projects} />
  <Types lang={lang} projects={projects} />
  <Featured lang={lang} featured={featured} />
  <Scale lang={lang} projects={projects} />
  <Presence lang={lang} projects={projects} />
  <Audiences lang={lang} projects={projects} />
  <Method lang={lang} />
  <FinalCta lang={lang} />
</Base>

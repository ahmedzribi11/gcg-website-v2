---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import ProjectImage from '../components/ProjectImage.astro'
import ProjectCard from '../components/ProjectCard.astro'
import FinalCta from '../components/FinalCta.astro'
import Icon from '../components/Icon.astro'
import { audiences } from '../data/audiences'
import { route, useT, type Lang } from '../i18n'
import { getProjects } from '../lib/projects'
import { whatsappLink } from '../lib/settings'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)
const fr = lang === 'fr'
const projects = await getProjects(lang)
const by = (slug: string) => projects.find((p) => p.slug === slug)!
const wa = whatsappLink(t('contact.form.intro'))

/** Arguments factuels (portfolio et réunion de cadrage). */
const reasons = fr
  ? [
      ['Depuis 2016', 'Dix ans de projets en Côte d’Ivoire, de Korhogo à Assinie.'],
      ['Une seule équipe', 'Ingénieurs, architectes et techniciens : plus de 20 collaborateurs organisés en quatre pôles.'],
      ['Nos propres moyens', 'Engins et équipements de chantier en propre pour maîtriser l’exécution.'],
      ['Tout type de projet', `Villas, résidences, hôtels, immeubles, usines, infrastructures : ${projects.length} projets au portfolio.`],
    ]
  : [
      ['Since 2016', 'Ten years of projects in Côte d’Ivoire, from Korhogo to Assinie.'],
      ['One team', 'Engineers, architects and technicians: more than 20 staff in four divisions.'],
      ['Our own equipment', 'Our own machinery and site equipment, so execution stays in our hands.'],
      ['Every kind of project', `Villas, residences, hotels, buildings, factories, infrastructure: ${projects.length} projects in the portfolio.`],
    ]
---

<Base lang={lang} alt={route('invest', fr ? 'en' : 'fr')} title={t('invest.label')} description={t('invest.lead')}>
  <PageHeader label={t('invest.label')} title={t('invest.title')} accent={fr ? 'construire avec GCG.' : 'build with GCG.'} lead={t('invest.lead')}>
    <nav class="flex flex-wrap gap-2 md:col-span-12" aria-label={t('audiences.label')} data-reveal style="--d:.3s">
      {audiences.map((a) => <a href={`#${a.id}`} class="chip">{a.title[lang]}</a>)}
    </nav>
  </PageHeader>

  {
    audiences.map((a, i) => (
      <section id={a.id} class:list={['scroll-mt-24 py-20 md:py-32', i % 2 === 1 ? 'bg-ink-2' : 'bg-ink']} aria-labelledby={`${a.id}-title`}>
        <div class="wrap grid gap-12 md:grid-cols-12 md:gap-16">
          <div class:list={['overflow-hidden md:col-span-6', i % 2 === 1 && 'md:order-2']} data-reveal="clip">
            <div data-parallax="6">
              <ProjectImage image={by(a.image).images[0]} sizes="(min-width: 768px) 50vw, 100vw" class="block aspect-[4/3] md:aspect-[5/4]" />
            </div>
          </div>
          <div class="flex flex-col justify-center md:col-span-6">
            <p class="meta text-gold" data-reveal>0{i + 1}</p>
            <h2 id={`${a.id}-title`} class="display mt-5 text-[clamp(2.4rem,5vw,5.2rem)]" data-split>{a.title[lang]}</h2>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-bone/70" data-reveal>{a.text[lang]}</p>
            <ul class="mt-8 border-t border-line" data-reveal>
              {a.points[lang].map((pt) => (
                <li class="flex items-center gap-3 border-b border-line py-3.5 text-[15px] text-bone/85">
                  <span class="h-1 w-1 rounded-full bg-gold" aria-hidden="true" />
                  {pt}
                </li>
              ))}
            </ul>
            <div class="mt-8 flex flex-wrap gap-3" data-reveal>
              {wa && (
                <a href={wa} target="_blank" rel="noopener" class="btn btn-gold">
                  <Icon name="whatsapp" size={16} /> WhatsApp
                </a>
              )}
              <a href={`${route('contact', lang)}?profil=${a.id}`} class:list={['btn', wa ? 'btn-line' : 'btn-gold']} data-magnetic>
                {t('cta.project')} <Icon name="arrow" />
              </a>
            </div>
          </div>
        </div>
        <div class="wrap mt-16 md:mt-20">
          <p class="meta text-mist" data-reveal>{t('invest.proof')}</p>
          <div class="mt-6 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
            {a.proof.map((slug, k) => (
              <ProjectCard project={by(slug)} lang={lang} index={k} transition={false} compact sizes="(min-width: 1024px) 23vw, (min-width: 640px) 45vw, 100vw" />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="theme-paper py-24 md:py-36" aria-labelledby="why-title">
    <div class="wrap">
      <p class="label text-brand/75" data-reveal>{t('invest.why')}</p>
      <h2 id="why-title" class="display mt-8 max-w-[16ch] text-[clamp(2.4rem,5.6vw,6rem)]" data-split>
        {fr ? 'Un partenaire,' : 'One partner,'} <em class="serif">{fr ? 'de l’étude aux clés.' : 'from study to keys.'}</em>
      </h2>
      <ol class="mt-16 grid gap-px overflow-hidden border border-brand/15 bg-brand/15 sm:grid-cols-2 lg:grid-cols-4 md:mt-24">
        {
          reasons.map(([title, text], i) => (
            <li class="flex flex-col gap-10 bg-paper p-7 md:p-9" data-reveal style={`--d:${i * 0.06}s`}>
              <span class="meta text-brand/75">0{i + 1}</span>
              <div>
                <h3 class="text-2xl font-light tracking-[-0.02em]">{title}</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-brand/70">{text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <FinalCta lang={lang} />
</Base>

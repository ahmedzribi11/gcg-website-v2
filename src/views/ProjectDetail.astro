---
import { getImage } from 'astro:assets'
import Base from '../layouts/Base.astro'
import ProjectImage from '../components/ProjectImage.astro'
import ProjectCard from '../components/ProjectCard.astro'
import Icon from '../components/Icon.astro'
import { getService } from '../data/services'
import { colon, qrPath, projectPath, route, SECTOR_LABELS, servicePath, STATUS_LABELS, useT, type Lang } from '../i18n'
import { pad, type Project } from '../lib/projects'
import { whatsappLink } from '../lib/settings'
import { breadcrumbLd } from '../lib/seo'

interface Props {
  lang: Lang
  project: Project
  all: Project[]
}
const { lang, project: p, all } = Astro.props
const t = useT(lang)
const other = lang === 'fr' ? 'en' : 'fr'
const idx = all.findIndex((x) => x.slug === p.slug)
const prev = all[(idx - 1 + all.length) % all.length]
const next = all[(idx + 1) % all.length]
const related = all
  .filter((x) => x.slug !== p.slug && (x.sector === p.sector || x.types.some((ty) => p.types.includes(ty))))
  .sort((a, b) => Number(b.sector === p.sector) - Number(a.sector === p.sector) || Math.abs(a.number - p.number) - Math.abs(b.number - p.number))
  .slice(0, 3)
const og = await getImage({ src: p.images[0].src, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })
const sheet: [string, string | undefined, string?][] = [
  [t('project.location'), p.location],
  [t('project.period'), p.period],
  [t('project.surface'), p.surface],
  [t('project.terrain'), p.terrain],
  [t('project.covered'), p.coveredSurface],
  [t('project.sector'), SECTOR_LABELS[p.sector][lang], `secteur=${p.sector}`],
  [t('project.status'), p.status ? STATUS_LABELS[p.status][lang] : undefined, p.status ? `statut=${p.status}` : undefined],
]
const path = projectPath(p.slug, lang)
/** Mise en page de la galerie : une grande image, deux petites, puis des rangées pleines. */
function galleryClass(i: number, n: number) {
  if (n === 2) return 'md:col-span-3'
  if (i === 0) return 'md:col-span-4 md:row-span-2'
  if (i < 3) return 'md:col-span-2'
  const rest = n - 3
  return rest % 2 === 1 && i === n - 1 ? 'md:col-span-6' : 'md:col-span-3'
}
const shareText = `${p.name} — GCG`
const wa = whatsappLink(`${t('contact.form.intro')} (${p.name})`)
const desc = `${p.composition} ${p.location}, ${p.period}.`
// Titre d’onglet unique par langue, ≈ 60 caractères au plus
const titleLong = `${p.name} · ${lang === 'fr' ? 'projet GCG, Côte d’Ivoire' : 'GCG project, Côte d’Ivoire'}`
const docTitle = titleLong.length <= 60 ? titleLong : `${p.name} · GCG`
const crumbs = breadcrumbLd(
  [
    { name: t('nav.home'), path: route('home', lang) },
    { name: t('projects.label'), path: route('projects', lang) },
    { name: p.name, path },
  ],
  Astro.site,
)

---

<Base lang={lang} alt={projectPath(p.slug, other)} title={p.name} docTitle={docTitle} description={desc} image={og.src} header="overlay" jsonLd={[crumbs]}>
  <article>
    <header class="relative flex h-[86svh] min-h-[560px] items-end overflow-hidden bg-ink-3 force-dark">
      <ProjectImage image={p.images[0]} sizes="100vw" priority class="absolute inset-0 block h-full w-full" vt={`p-${p.slug}`} />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/50 to-ink/50"></div>
      <div class="wrap relative pb-12 md:pb-16">
        <nav class="meta flex flex-wrap items-center gap-2 text-bone/70" aria-label={lang === 'fr' ? 'Fil d’Ariane' : 'Breadcrumb'} data-reveal>
          <a href={route('home', lang)} class="hover:text-gold">{t('nav.home')}</a>
          <span aria-hidden="true">/</span>
          <a href={route('projects', lang)} class="hover:text-gold">{t('projects.label')}</a>
          <span aria-hidden="true">/</span>
          <span class="text-gold" aria-current="page">{p.name}</span>
        </nav>
        <h1 class="display mt-6 max-w-[16ch] text-balance text-[clamp(2.8rem,8vw,8.8rem)]" data-split>{p.name}</h1>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3" data-reveal style="--d:.3s">
          {p.status && <span class="pill" data-status={p.status}>{STATUS_LABELS[p.status][lang]}</span>}
          <span class="flex items-center gap-2 text-[15px] text-bone/80"><Icon name="pin" size={16} class="text-gold" />{p.location}</span>
          <span class="flex items-center gap-2 text-[15px] text-bone/80"><Icon name="clock" size={16} class="text-gold" />{p.period}</span>
          {p.surface && <span class="text-[15px] text-bone/80">{p.surface}</span>}
        </div>
      </div>
    </header>

    <div class="wrap grid gap-16 py-20 md:grid-cols-12 md:py-28">
      <div class="md:col-span-7">
        <p class="label text-gold" data-reveal>{t('project.composition')}</p>
        <p class="mt-6 text-[clamp(1.6rem,2.8vw,2.6rem)] font-light leading-[1.2] tracking-[-0.02em]" data-reveal>{p.composition}</p>
        {p.typology && <p class="mt-6 text-lg text-bone/70" data-reveal><span class="meta mr-3 text-mist">{t('project.typology')}</span>{p.typology}</p>}

        <h2 class="label mt-16 text-gold" data-reveal>{t('project.missions')}</h2>
        <ol class="mt-6 border-t border-line">
          {
            p.missions.map((m, i) => (
              <li class="flex gap-6 border-b border-line py-5 text-xl font-light md:text-2xl" data-reveal style={`--d:${i * 0.05}s`}>
                <span class="meta pt-2 text-mist">{pad(i + 1)}</span>
                {m}
              </li>
            ))
          }
        </ol>

        {
          p.typologies && (
            <>
              <h2 class="label mt-16 text-gold" data-reveal>{t('project.typologies')}</h2>
              <table class="mt-6 w-full border-t border-line text-left" data-reveal>
                <thead class="sr-only">
                  <tr><th>{t('project.typology')}</th><th>{t('project.surface')}</th></tr>
                </thead>
                <tbody>
                  {p.typologies.map((ty) => (
                    <tr class="border-b border-line">
                      <td class="py-5 text-xl font-light md:text-2xl">{ty.name}</td>
                      <td class="py-5 text-right font-mono text-sm text-gold">{ty.surface}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )
        }

        {
          p.services.length > 0 && (
            <>
              <h2 class="label mt-16 text-gold" data-reveal>{t('project.services')}</h2>
              <ul class="mt-6 flex flex-wrap gap-2" data-reveal>
                {p.services.map((id) => {
                  const s = getService(id)
                  return (
                    <li>
                      <a href={servicePath(s.slug[lang], lang)} class="chip">{s.title[lang]}</a>
                    </li>
                  )
                })}
              </ul>
            </>
          )
        }
      </div>

      <aside class="md:col-span-4 md:col-start-9">
        <div class="cartouche border border-bone/30 bg-ink-2" data-reveal>
          <div class="flex items-center justify-between bg-brand px-5 py-3">
            <span class="meta text-gold">{t('project.sheet')}</span>
            <span class="meta text-gold">N° {pad(p.number)}</span>
          </div>
          <p class="border-b border-line px-5 py-4 text-lg font-light">{p.name}</p>
          <dl class="grid grid-cols-[auto_1fr]">
            {
              sheet
                .filter(([, v]) => v)
                .map(([k, v, q]) => (
                  <>
                    <dt class="meta border-b border-r border-line px-5 py-3.5 text-mist">{k}</dt>
                    <dd class="border-b border-line px-5 py-3.5 text-[15px]">{q ? <a href={`${route('projects', lang)}?${q}`} class="link-line hover:text-gold">{v}</a> : v}</dd>
                  </>
                ))
            }
          </dl>
          <div class="flex items-end justify-between gap-4 px-5 py-4">
            <span class="meta text-mist">General Constructor Group CI</span>
            <img src="/brand/gcg-logo-gold.png" alt="" width="720" height="218" class="h-6 w-auto opacity-80" loading="lazy" />
          </div>
        </div>

        <div class="mt-6 border border-line p-5" data-reveal style="--d:.1s">
          <p class="meta text-gold">{t('project.share')}</p>
          <div class="mt-4 flex gap-4">
            <span id="project-qr" class="block w-24 shrink-0 rounded bg-white p-1" data-qr={qrPath(lang, 'panneau', p.slug)}></span>
            <div class="flex flex-col gap-2">
              <button type="button" class="chip !h-9 !text-[12px]" data-share={path} data-title={shareText} data-copied={t('project.copied')}>
                <Icon name="share" size={14} /> <span data-copy-label>{t('cta.share')}</span>
              </button>
              <button type="button" class="chip !h-9 !text-[12px]" data-copy={path} data-copied={t('project.copied')}>
                <Icon name="link" size={14} /> <span data-copy-label>{t('project.copy')}</span>
              </button>
              <a href={`${route('poster', lang)}?p=${p.slug}`} class="chip !h-9 !text-[12px]"><Icon name="print" size={14} /> {t('project.poster')}</a>
            </div>
          </div>
          <p class="mt-4 text-[13px] leading-relaxed text-bone/55">{t('project.qrHelp')}</p>
        </div>
      </aside>
    </div>

    {
      p.images.length > 1 && (
        <section class="wrap pb-20 md:pb-28" aria-label={t('project.gallery')}>
          <div class="gallery grid gap-3 md:grid-cols-6">
            {p.images.map((img, i) => (
              <button
                type="button"
                class:list={['group relative overflow-hidden bg-ink-3', galleryClass(i, p.images.length)]}
                data-lightbox={i}
                data-cursor="view"
                aria-label={`${t('project.enlarge')}${colon(lang)}${img.alt}`}
                aria-haspopup="dialog"
                data-reveal="clip"
              >
                <ProjectImage image={img} sizes={i === 0 ? '(min-width: 768px) 66vw, 100vw' : '(min-width: 768px) 33vw, 100vw'} class="block aspect-[4/3] h-full w-full" imgClass="h-full w-full object-cover transition-transform duration-[1.4s] ease-[var(--ease-out-expo)] group-hover:scale-[1.04]" />
              </button>
            ))}
          </div>
        </section>
      )
    }

    <dialog id="lightbox" class="lightbox m-0 h-full max-h-none w-full max-w-none bg-ink/95 p-0 text-bone backdrop:bg-ink/90" aria-label={t('project.gallery')}>
      <div class="relative flex h-full w-full items-center justify-center">
        {
          p.images.map((img, i) => (
            <figure data-slide={i} hidden class="flex h-full w-full items-center justify-center p-4 md:p-16">
              <ProjectImage image={img} sizes="100vw" class="block max-h-full" imgClass="max-h-[82svh] w-auto max-w-full object-contain" />
            </figure>
          ))
        }
        <p class="meta absolute left-5 top-5 text-bone/70" aria-live="polite"><span data-lb-index>1</span> / {p.images.length}</p>
        <button type="button" class="absolute right-4 top-4 flex h-12 w-12 items-center justify-center rounded-full border border-line hover:border-gold" data-lb-close aria-label={t('project.close')}><Icon name="close" size={18} /></button>
        <button type="button" class="absolute left-4 top-1/2 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-line bg-ink/60 hover:border-gold" data-lb-prev aria-label={t('project.prev')}><Icon name="arrow-left" size={18} /></button>
        <button type="button" class="absolute right-4 top-1/2 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-line bg-ink/60 hover:border-gold" data-lb-next aria-label={t('project.next')}><Icon name="arrow" size={18} /></button>
      </div>
    </dialog>

    <section class="theme-paper py-20 md:py-28">
      <div class="wrap flex flex-col items-start justify-between gap-8 md:flex-row md:items-end">
        <div>
          <p class="label text-brand/75" data-reveal>{t('project.similar')}</p>
          <h2 class="display mt-6 max-w-[18ch] text-[clamp(2.2rem,5vw,5rem)]" data-split>{t('project.similarText')}</h2>
        </div>
        <div class="flex flex-wrap gap-3" data-reveal>
          {wa && <a href={wa} target="_blank" rel="noopener" class="btn btn-dark"><Icon name="whatsapp" size={16} /> WhatsApp</a>}
          <a href={`${route('contact', lang)}?projet=${p.slug}`} class:list={['btn', wa ? 'btn-line-dark' : 'btn-dark']}>{t('cta.project')} <Icon name="arrow" /></a>
        </div>
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="wrap py-20 md:py-28" aria-labelledby="related-title">
          <h2 id="related-title" class="label text-gold" data-reveal>{t('project.related')}</h2>
          <div class="mt-10 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r, i) => <ProjectCard project={r} lang={lang} index={i} />)}
          </div>
        </section>
      )
    }

    <nav class="grid border-t border-line md:grid-cols-2" aria-label={lang === 'fr' ? 'Projets voisins' : 'Adjacent projects'}>
      <a href={projectPath(prev.slug, lang)} class="group block border-b border-line px-5 py-12 md:border-b-0 md:border-r md:px-10 md:py-16">
        <span class="meta flex items-center gap-2 text-mist"><Icon name="arrow-left" /> {t('project.prev')}</span>
        <span class="display mt-4 block text-[clamp(1.8rem,3.4vw,3.4rem)] text-bone/50 transition-colors duration-500 group-hover:text-bone">{prev.name}</span>
      </a>
      <a href={projectPath(next.slug, lang)} class="group block px-5 py-12 text-right md:px-10 md:py-16">
        <span class="meta flex items-center justify-end gap-2 text-mist">{t('project.next')} <Icon name="arrow" /></span>
        <span class="display mt-4 block text-[clamp(1.8rem,3.4vw,3.4rem)] text-bone/50 transition-colors duration-500 group-hover:text-bone">{next.name}</span>
      </a>
    </nav>
  </article>
<script>
  import '../scripts/qr'
  import { lockScroll } from '../scripts/site'

  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null
  if (dlg) {
    const slides = Array.from(dlg.querySelectorAll<HTMLElement>('[data-slide]'))
    const label = dlg.querySelector<HTMLElement>('[data-lb-index]')!
    let i = 0
    const show = (n: number) => {
      i = (n + slides.length) % slides.length
      slides.forEach((s, k) => (s.hidden = k !== i))
      label.textContent = String(i + 1)
    }
    let opener: HTMLElement | null = null
    let viaHistory = false
    document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((b) =>
      b.addEventListener('click', () => {
        opener = b
        show(Number(b.dataset.lightbox))
        dlg.showModal()
        lockScroll(true)
        // Le bouton « retour » du téléphone ferme la visionneuse au lieu de quitter la page
        history.pushState({ lightbox: true }, '')
      }),
    )
    dlg.addEventListener('close', () => {
      lockScroll(false)
      opener?.focus()
      if (!viaHistory && history.state?.lightbox) history.back()
      viaHistory = false
    })
    addEventListener('popstate', () => {
      if (dlg.open) {
        viaHistory = true
        dlg.close()
      }
    })
    dlg.querySelector('[data-lb-close]')!.addEventListener('click', () => dlg.close())
    dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(i - 1))
    dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(i + 1))
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1)
      if (e.key === 'ArrowRight') show(i + 1)
    })
    let x0: number | null = null
    dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true })
    dlg.addEventListener('touchend', (e) => {
      if (x0 === null) return
      const dx = e.changedTouches[0].clientX - x0
      if (Math.abs(dx) > 50) show(i + (dx < 0 ? 1 : -1))
      x0 = null
    })
    if (slides.length < 2) dlg.querySelectorAll('[data-lb-prev], [data-lb-next]').forEach((b) => b.remove())
  }
</script>

<style>
  .lightbox[open] { display: block; }
  .lightbox::backdrop { backdrop-filter: blur(6px); }
</style>
</Base>

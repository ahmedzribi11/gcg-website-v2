---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import ProjectImage from '../components/ProjectImage.astro'
import Method from '../components/Method.astro'
import FinalCta from '../components/FinalCta.astro'
import Icon from '../components/Icon.astro'
import { services } from '../data/services'
import { route, servicePath, useT, type Lang } from '../i18n'
import { coverImage, getProjects } from '../lib/projects'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)
const projects = await getProjects(lang)
const count = (id: string) => projects.filter((p) => p.services.includes(id as never)).length
---

<Base lang={lang} alt={route('services', lang === 'fr' ? 'en' : 'fr')} title={t('services.label')} description={t('services.lead')}>
  <PageHeader label={t('services.label')} title={t('services.title')} accent={lang === 'fr' ? 'même toit.' : 'one roof.'} lead={t('services.lead')} />

  <section class="wrap pb-24 md:pb-40">
    {
      services.map((s, i) => {
        const n = count(s.id)
        const flip = i % 2 === 1
        return (
          <article id={s.slug[lang]} class="grid gap-8 border-t border-line py-14 md:grid-cols-12 md:gap-12 md:py-20">
            <a href={servicePath(s.slug[lang], lang)} class:list={['group relative block overflow-hidden md:col-span-5', flip && 'md:order-2 md:col-start-8']} data-reveal="clip" data-cursor="view" aria-label={s.title[lang]}>
              <div data-parallax="6">
                <ProjectImage image={coverImage(projects, s.cover)} alt="" sizes="(min-width: 768px) 40vw, 100vw" class="block aspect-[4/3] md:aspect-[5/4]" imgClass="h-full w-full object-cover transition-transform duration-[1.6s] ease-[var(--ease-out-expo)] group-hover:scale-[1.04]" />
              </div>
            </a>
            <div class:list={['flex flex-col justify-between md:col-span-6', flip ? 'md:order-1 md:col-start-1' : 'md:col-start-7']}>
              <div>
                <p class="meta text-gold" data-reveal>{String(i + 1).padStart(2, '0')} · {n} {n > 1 ? t('services.projects') : t('services.project')}</p>
                <h2 class="display mt-5 text-[clamp(2.2rem,4.6vw,4.8rem)]" data-split>
                  {s.id === 'cle-en-main' ? <em class="serif text-gold">{s.title[lang]}</em> : s.title[lang]}
                </h2>
                <p class="mt-6 max-w-xl text-lg leading-relaxed text-bone/70" data-reveal>{s.intro[lang]}</p>
              </div>
              <div class="mt-10">
                <ul class="grid gap-x-6 border-t border-line sm:grid-cols-2" data-reveal>
                  {s.includes[lang].map((it) => (
                    <li class="flex items-center gap-3 border-b border-line py-3 text-[15px] text-bone/80">
                      <span class="h-1 w-1 rounded-full bg-gold" aria-hidden="true" />
                      {it}
                    </li>
                  ))}
                </ul>
                <a href={servicePath(s.slug[lang], lang)} class="btn btn-line mt-8" data-magnetic>
                  {t('cta.more')} <Icon name="arrow" />
                </a>
              </div>
            </div>
          </article>
        )
      })
    }
  </section>

  <Method lang={lang} tone="paper" />
  <FinalCta lang={lang} />
</Base>
